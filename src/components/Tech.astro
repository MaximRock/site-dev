---
import { CONTACTS, PLATFORMS } from "../data/site.js";
import Icon from "./Icon.astro";
import { Icon as BrandIcon } from "astro-icon/components";
---

<section class="section-spacing bg-section/50">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Технологии</p>
      <h2 class="text-3xl sm:text-4xl">Tilda или индивидуальная разработка?</h2>
      <p class="mt-4 text-muted">
        Вам не нужно разбираться в технологиях. Мы подберём вариант под задачу и бюджет.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {
        Object.values(PLATFORMS).map((platform) => (
          <article class="card flex flex-col p-7 hover:bg-card-hover">
            <div class="flex items-center justify-between">
              <h3 class="text-2xl">{platform.title}</h3>
            </div>
            <p class="mt-2 text-sm text-muted">{platform.text}</p>
            <ul class="mt-5 flex flex-1 flex-col gap-2.5">
              {platform.points.map((point) => (
                <li class="flex items-start gap-3 text-body">
                  <Icon name="check" size={18} class="mt-0.5 text-accent" />
                  {point}
                </li>
              ))}
            </ul>
            <a href="#lead-form" class="btn btn-ghost mt-6 w-full">{platform.cta}</a>
          </article>
        ))
      }
    </div>

    <aside class="card mt-8 flex flex-col gap-6 p-7 sm:flex-row sm:items-center">
      <div class="min-w-0 flex-1">
        <h3 class="text-xl">Обсудим, что подходит вам</h3>
        <p class="mt-2 text-sm text-muted">
          Напишите нам — разберем задачу и подскажем оптимальный формат.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <a href={CONTACTS.max} target="_blank" rel="noopener noreferrer" class="chip transition hover:border-accent hover:text-heading">
          <svg viewBox="0 0 500 500" class="h-6 w-6 shrink-0 text-accent" aria-hidden="true">
            <path fill="currentColor" fill-rule="evenodd" d="M253.223 398.85c-29.441 0-43.123-4.298-66.905-21.49-15.043 19.341-62.679 34.456-64.756 8.596 0-19.412-4.298-35.816-9.17-53.725C106.59 310.168 100 285.598 100 249.997 100 164.968 169.771 101 252.435 101c82.736 0 147.564 67.12 147.564 149.784.278 81.386-65.391 147.632-146.776 148.066m1.218-224.355c-40.258-2.077-71.633 25.788-78.582 69.484-5.73 36.175 4.442 80.229 13.109 82.522 4.155 1.002 14.613-7.45 21.132-13.969a74.5 74.5 0 0 0 36.39 12.966c41.713 2.006 77.356-29.75 80.157-71.418 1.63-41.756-30.487-77.123-72.206-79.513z" />
          </svg>
          Max 
        </a>
        <a href={CONTACTS.telegram} target="_blank" rel="noopener noreferrer" class="chip transition hover:border-accent hover:text-heading">
          <BrandIcon name="simple-icons:telegram" size={16} class="text-accent" />
          Telegram
        </a>
        <a href={CONTACTS.whatsapp} target="_blank" rel="noopener noreferrer" class="chip transition hover:border-accent hover:text-heading">
          <BrandIcon name="simple-icons:whatsapp" size={16} class="text-accent" />
          WhatsApp
        </a>
      </div>
    </aside>
  </div>
</section>
