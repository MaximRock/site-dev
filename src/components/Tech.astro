---
import { CONTACTS } from "../data/site.js";
import Icon from "./Icon.astro";
import { Icon as BrandIcon } from "astro-icon/components";

const platforms = [
  {
    key: "tilda",
    title: "Tilda",
    points: ["Быстрый запуск", "Подходит большинству компаний", "Простая поддержка сайта"],
  },
  {
    key: "custom",
    title: "Индивидуальная разработка",
    points: ["Максимальная производительность", "Любой функционал", "Любые интеграции", "Любой дизайн"],
  },
];

const channels = [
  { label: "Telegram", href: CONTACTS.telegram, icon: "telegram" },
  { label: "WhatsApp", href: CONTACTS.whatsapp, icon: "whatsapp" },
  { label: "Макс", href: CONTACTS.max, icon: "max" },
  { label: "Телефон", href: CONTACTS.phoneUrl, icon: "phone" },
  { label: "Email", href: CONTACTS.emailUrl, icon: "mail" },
];
---

<section class="section-spacing bg-section/50">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Технологии и поддержка</p>
      <h2 class="text-3xl sm:text-4xl">На чем создаем сайты</h2>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {
        platforms.map((platform) => (
          <article class="card flex flex-col p-7 hover:bg-[#202025]">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/15 text-accent2">
              <Icon name={platform.key === "tilda" ? "window" : "code"} size={24} />
            </div>
            <h3 class="mt-5 text-2xl">{platform.title}</h3>
            <ul class="mt-4 flex flex-1 flex-col gap-2.5">
              {
                platform.points.map((point) => (
                  <li class="flex items-start gap-3 text-body">
                    <Icon name="check" size={20} class="mt-0.5 text-accent2" />
                    {point}
                  </li>
                ))
              }
            </ul>
          </article>
        ))
      }
    </div>

    <aside class="card mt-8 flex flex-col gap-6 p-7 sm:flex-row sm:items-center">
      <div class="min-w-0 flex-1">
        <h3 class="text-xl">Поддержка после запуска</h3>
        <p class="mt-2 text-sm text-muted">
          Правки входят в сопровождение. Связь семь дней в неделю.
        </p>
      </div>
      <ul class="flex flex-wrap gap-3">
        {
          channels.map((channel) => (
            <li>
              <a
                href={channel.href}
                target={channel.href.startsWith("http") ? "_blank" : undefined}
                rel={channel.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="chip transition hover:border-accent hover:text-heading"
              >
                {
                  channel.icon === "max" ? (
                    <svg viewBox="0 0 500 500" class="h-4 w-4 shrink-0 text-accent2" aria-hidden="true">
                      <path
                        fill="currentColor"
                        fill-rule="evenodd"
                        d="M253.223 398.85c-29.441 0-43.123-4.298-66.905-21.49-15.043 19.341-62.679 34.456-64.756 8.596 0-19.412-4.298-35.816-9.17-53.725C106.59 310.168 100 285.598 100 249.997 100 164.968 169.771 101 252.435 101c82.736 0 147.564 67.12 147.564 149.784.278 81.386-65.391 147.632-146.776 148.066m1.218-224.355c-40.258-2.077-71.633 25.788-78.582 69.484-5.73 36.175 4.442 80.229 13.109 82.522 4.155 1.002 14.613-7.45 21.132-13.969a74.5 74.5 0 0 0 36.39 12.966c41.713 2.006 77.356-29.75 80.157-71.418 1.63-41.756-30.487-77.123-72.206-79.513z"
                      />
                    </svg>
                  ) : channel.icon === "telegram" || channel.icon === "whatsapp" ? (
                    <BrandIcon name={`simple-icons:${channel.icon}`} size={16} class="text-accent2" />
                  ) : (
                    <Icon name={channel.icon} size={16} class="text-accent2" />
                  )
                }
                {channel.label}
              </a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</section>