<section id="calculator" class="section-spacing bg-section/50">
  <div class="container-x">
    <div class="mx-auto max-w-2xl pb-10 text-center">
      <p class="eyebrow mb-4">Калькулятор стоимости</p>
      <h2 class="text-3xl sm:text-4xl">Ориентировочная стоимость за 1 минуту</h2>
      <p class="mt-4 text-muted">4 вопроса — и вы увидите примерный диапазон бюджета на ваш проект.</p>
    </div>

    <div id="calc-card" class="card mx-auto max-w-2xl p-6 sm:p-8">
      <div class="mb-7 flex items-center gap-4">
        <div class="h-2 flex-1 overflow-hidden rounded-full bg-white/10">
          <div id="calc-progress" class="h-full rounded-full bg-accent transition-all duration-300" style="width: 10%"></div>
        </div>
        <span id="calc-step-label" class="shrink-0 text-sm text-muted">1 из 4</span>
      </div>

      <div id="calc-step" class="min-h-[180px]"></div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <button id="calc-back" type="button" class="btn btn-neutral w-full sm:w-auto" hidden>Назад</button>
        <button id="calc-next" type="button" class="btn btn-primary w-full sm:w-auto">Дальше</button>
      </div>
    </div>

    <div id="calc-result" hidden class="card mx-auto mt-6 max-w-2xl p-6 sm:p-8" aria-live="polite">
      <p class="eyebrow mb-4">Ориентировочная стоимость</p>
      <h3 id="calc-result-type" class="text-2xl"></h3>
      <p id="calc-result-price" class="mt-3 font-display text-3xl font-extrabold text-accent"></p>
      <p class="mt-4 text-sm text-muted">
        Это предварительный расчёт. Точная стоимость и состав работ определяются на бесплатном разборе.
      </p>
      <div class="mt-6 flex flex-col gap-3 sm:flex-row">
        <a href="#lead-form" class="btn btn-primary" data-goal="click_consultation">Получить точный расчёт</a>
        <button id="calc-reset" type="button" class="btn btn-neutral">Рассчитать снова</button>
      </div>
    </div>
  </div>
</section>

<script>
type StepOption = { value: string; label: string };
type Step = { title: string; options: StepOption[] };

const steps: Step[] = [
  {
    title: "Какой тип сайта вам нужен?",
    options: [
      { value: "landing", label: "Лендинг" },
      { value: "visitka", label: "Сайт-визитка" },
      { value: "multipage", label: "Многостраничный" },
      { value: "shop", label: "Интернет-магазин" },
      { value: "custom", label: "Индивидуальный проект" },
      { value: "unknown", label: "Ещё не знаю" },
    ],
  },
  {
    title: "Сколько страниц планируется?",
    options: [
      { value: "1", label: "1" },
      { value: "2-5", label: "2–5" },
      { value: "6-10", label: "6–10" },
      { value: "10+", label: "10+" },
    ],
  },
  {
    title: "Какой дизайн вам нужен?",
    options: [
      { value: "ready", label: "По готовой структуре / шаблону" },
      { value: "custom", label: "Индивидуальный дизайн" },
    ],
  },
  {
    title: "Какой функционал нужен?",
    options: [
      { value: "forms", label: "Формы заявок" },
      { value: "messengers", label: "Кнопки мессенджеров" },
      { value: "crm", label: "Интеграция с CRM" },
      { value: "analytics", label: "Аналитика" },
      { value: "catalog", label: "Каталог" },
      { value: "other", label: "Другое" },
    ],
  },
];

const BASE: Record<string, number> = {
  landing: 15000,
  visitka: 20000,
  multipage: 25000,
  shop: 35000,
  custom: 30000,
  unknown: 15000,
};

const FEATURE_ADD: Record<string, number> = {
  crm: 5000,
  catalog: 8000,
  analytics: 2000,
  custom: 15000,
};

function computeRange(answers: Record<number, string>): [number, number] {
  const type = answers[0] ?? "unknown";
  const base = BASE[type] ?? 15000;
  let min = base;
  let max = base;

  const pages = answers[1] ?? "1";
  if (pages === "2-5") { min += 2000; max += 5000; }
  if (pages === "6-10") { min += 8000; max += 15000; }
  if (pages === "10+") { min += 12000; max += 25000; }

  const design = answers[2] ?? "custom";
  if (design === "custom") { min += 8000; max += 20000; }

  const feat = answers[3] ?? "forms";
  const add = FEATURE_ADD[feat] ?? 0;
  max += add;

  return [Math.round(min / 1000) * 1000, Math.round(max / 1000) * 1000];
}

const TYPE_LABELS: Record<string, string> = {
  landing: "Лендинг",
  visitka: "Сайт-визитка",
  multipage: "Многостраничный",
  shop: "Интернет-магазин",
  custom: "Индивидуальный проект",
  unknown: "Подбираем решение",
};

function formatPrice(n: number): string {
  return n.toLocaleString("ru-RU").replace(/ /g, "\u00a0") + "\u00a0₽";
}

const stepBox = document.getElementById("calc-step") as HTMLElement | null;
const nextBtn = document.getElementById("calc-next") as HTMLButtonElement | null;
const backBtn = document.getElementById("calc-back") as HTMLButtonElement | null;
const progress = document.getElementById("calc-progress") as HTMLElement | null;
const stepLabel = document.getElementById("calc-step-label") as HTMLElement | null;
const card = document.getElementById("calc-card") as HTMLElement | null;
const result = document.getElementById("calc-result") as HTMLElement | null;
const resetBtn = document.getElementById("calc-reset") as HTMLButtonElement | null;

const answers: Record<number, string> = {};
let current = 0;
const total = steps.length;

function renderStep() {
  if (!stepBox || !stepLabel || !progress || !nextBtn || !backBtn) return;
  const step = steps[current];

  stepLabel.textContent = `${current + 1} из ${total}`;
  progress.style.width = `${((current + 1) / total) * 100}%`;
  backBtn.hidden = false;
  nextBtn.textContent = current === total - 1 ? "Показать стоимость" : "Дальше";

  stepBox.innerHTML = `
    <h3 class="mb-6 text-xl sm:text-2xl">${step.title}</h3>
    <div class="flex flex-col gap-3">
      ${step.options
        .map(
          (o) => `
            <button type="button" class="option" data-calc-value="${o.value}"
              aria-pressed="${answers[current] === o.value}">
              ${o.label}
            </button>
          `
        )
        .join("")}
    </div>
  `;

  stepBox.querySelectorAll<HTMLButtonElement>("[data-calc-value]").forEach((btn) => {
    btn.addEventListener("click", () => {
      answers[current] = btn.dataset.calcValue ?? "";
      stepBox.querySelectorAll("[data-calc-value]").forEach((b) =>
        b.setAttribute("aria-pressed", "false")
      );
      btn.setAttribute("aria-pressed", "true");
    });
  });
}

function showResult() {
  const [min, max] = computeRange(answers);
  const type = answers[0] ?? "unknown";

  const resultType = document.getElementById("calc-result-type") as HTMLElement | null;
  const resultPrice = document.getElementById("calc-result-price") as HTMLElement | null;

  if (resultType) resultType.textContent = TYPE_LABELS[type] ?? "Проект";
  if (resultPrice) resultPrice.textContent = `${formatPrice(min)} – ${formatPrice(max)}`;

  ;(window as any).__track?.("calculator_complete");

  if (card) card.hidden = true;
  if (result) result.hidden = false;
  result?.scrollIntoView({ behavior: "smooth", block: "center" });
}

nextBtn?.addEventListener("click", () => {
  if (!answers[current]) {
    stepBox?.querySelectorAll<HTMLButtonElement>(".option").forEach((btn) => {
      btn.classList.add("field-error");
      setTimeout(() => btn.classList.remove("field-error"), 800);
    });
    return;
  }
  if (current === 0) (window as any).__track?.("calculator_start");
  if (current < total - 1) {
    current += 1;
    renderStep();
  } else {
    showResult();
  }
});

backBtn?.addEventListener("click", () => {
  if (current > 0) {
    current -= 1;
    renderStep();
  }
});

resetBtn?.addEventListener("click", () => {
  for (const k of Object.keys(answers)) delete answers[Number(k)];
  current = 0;
  if (card) card.hidden = false;
  if (result) result.hidden = true;
  renderStep();
  card?.scrollIntoView({ behavior: "smooth", block: "center" });
});

renderStep();
</script>
