---
import { DIRECTIONS } from "../data/site.js";
import Icon from "./Icon.astro";
---

<section id="services" class="section-spacing bg-section/50">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Услуги</p>
      <h2 class="text-3xl sm:text-4xl">Подбираем сайт под задачи вашего бизнеса</h2>
      <p class="mt-4 text-muted">
        Определяем тип сайта, структуру и функционал после анализа целей, аудитории и конкурентов.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        DIRECTIONS.map((d) => (
          <article class="card group p-6 hover:bg-[#202025]">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/15 text-accent2 transition group-hover:text-accent4">
              <Icon name={d.icon} size={24} />
            </div>
            <h3 class="mt-5 text-xl">{d.title}</h3>
            <p class="mt-2 text-sm text-muted">{d.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>