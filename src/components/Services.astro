---
import { PLATFORMS, SERVICES } from "../data/site.js";
---

<section id="services" class="section-spacing bg-section">
  <div class="container-x grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
    <div>
      <p class="eyebrow mb-4">Форматы и цены</p>
      <h2 class="text-3xl sm:text-4xl">Какой сайт нужен вашему бизнесу</h2>
      <p class="mt-4 max-w-prose text-muted">
        Не каждому бизнесу нужен большой дорогой сайт. Иногда правильное
        решение: простой лендинг.
      </p>
      <p class="mt-3 max-w-prose text-muted">
        Мы работаем напрямую, поэтому платите только за результат.
      </p>

      <div class="mt-6 flex flex-col gap-3">
        {
          Object.values(PLATFORMS).map((platform) => (
            <p class="text-sm text-muted">
              <span class="font-display font-semibold text-heading">
                {platform.title}:
              </span>{" "}
              {platform.points.slice(0, 3).join(", ")}.
            </p>
          ))
        }
      </div>
    </div>

    <ul class="flex flex-col gap-3">
      {
        SERVICES.map((service) => (
          <li class="card grid gap-3 p-5 sm:grid-cols-[1fr_auto] sm:items-start sm:p-6">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="text-xl">{service.title}</h3>
                {service.popular && <span class="chip">Популярен</span>}
              </div>
              <p class="mt-2 text-sm text-muted">{service.text}</p>
              <p class="mt-2 text-sm text-muted">{service.audience}</p>
            </div>
            <p class="font-display text-lg font-bold text-heading">
              {service.price}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
