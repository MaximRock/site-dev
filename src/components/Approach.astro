---
import Icon from "./Icon.astro";

const points = [
  { icon: "user", title: "Целевая аудитория", text: "Анализируем, кто ваши клиенты и что им важно." },
  { icon: "search", title: "Конкуренты", text: "Изучаем, как сайты построены в вашей нише." },
  { icon: "chart", title: "Путь клиента", text: "Проектируем путь от знакомства до заявки." },
  { icon: "sparkles", title: "Сильные стороны", text: "Выделяем конкурентные преимущества компании." },
];
---

<section class="section-spacing">
  <div class="container-x grid gap-10 lg:grid-cols-2 lg:items-center">
    <div>
      <p class="eyebrow mb-4">Наш подход</p>
      <h2 class="text-3xl sm:text-4xl">Почему наши сайты продают</h2>
      <p class="mt-4 text-muted">
        Большинство сайтов не окупают вложения, потому что создаются без анализа бизнеса.
        Мы сначала изучаем вашу ситуацию и только после этого создаем сайт.
      </p>
      <a href="#calculator" class="btn btn-primary mt-8">Рассчитать стоимость</a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        points.map((point) => (
          <article class="card p-6 hover:bg-[#202025]">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/15 text-accent2">
              <Icon name={point.icon} size={24} />
            </div>
            <h3 class="mt-4 text-lg">{point.title}</h3>
            <p class="mt-1.5 text-sm text-muted">{point.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>