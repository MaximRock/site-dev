---
import { APPROACH_STEPS } from "../data/site.js";
import Icon from "./Icon.astro";
---

<section class="section-spacing">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Наш подход</p>
      <h2 class="text-3xl sm:text-4xl">Мы начинаем не с дизайна. Мы начинаем с задачи.</h2>
      <p class="mt-4 text-muted">
        Красивый сайт сам по себе не продаёт. Поэтому сначала разбираемся в бизнесе,
        а уже потом открываем Figma.
      </p>
    </div>

    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        APPROACH_STEPS.map((step) => (
          <li class="card group p-6 transition hover:border-accent/50 hover:bg-card-hover">
            <span class="font-display text-4xl font-extrabold text-edge transition group-hover:text-accent">
              {step.num}
            </span>
            <h3 class="mt-3 text-lg">{step.title}</h3>
            <p class="mt-1.5 text-sm text-muted">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <!-- Schematic line -->
    <div class="mt-10 hidden items-center justify-center gap-2 lg:flex" aria-hidden="true">
      {
        ["ЦА", "ОФФЕР", "СТРУКТУРА", "ДИЗАЙН", "КОД", "ЗАЯВКА"].map((step, i) => (
          <div class="flex items-center gap-2">
            <span class="rounded-xl border border-line bg-card px-4 py-2.5 font-display text-xs font-bold uppercase tracking-wider text-body">
              {step}
            </span>
            {i < 5 && <Icon name="arrowRight" size={18} class="text-accent/70" />}
          </div>
        ))
      }
    </div>

    <!-- Mobile: compact list -->
    <ol class="mt-10 flex flex-col items-center gap-2 lg:hidden" aria-label="Путь клиента">
      {
        ["ЦА", "ОФФЕР", "СТРУКТУРА", "ДИЗАЙН", "КОД", "ЗАЯВКА"].map((step) => (
          <li class="flex items-center gap-2">
            <span class="rounded-xl border border-line bg-card px-4 py-2.5 font-display text-xs font-bold uppercase tracking-wider text-body">
              {step}
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</section>