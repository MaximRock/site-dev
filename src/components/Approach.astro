---
import { APPROACH_STEPS } from "../data/site.js";
import Icon from "./Icon.astro";
---

<section class="section-spacing">
  <div class="container-x">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-center">
      <!-- Left -->
      <div class="lg:w-[40%]">
        <p class="eyebrow mb-4">Наш подход</p>
        <h2 class="text-3xl sm:text-4xl">Сайт, который продает, начинается с анализа</h2>
        <p class="mt-4 text-muted">
          Мы не берем первый понравившийся шаблон. Сначала разбираемся в вашем бизнесе,
          аудитории и задачах — и только потом создаем сайт.
        </p>
        <a href="#lead-form" class="btn btn-primary mt-8">Получить бесплатный разбор</a>
      </div>

      <!-- Right steps -->
      <div class="flex-1">
        <ol class="flex flex-col gap-6">
          {
            APPROACH_STEPS.map((step) => (
              <li class="flex items-start gap-4">
                <span class="flex h-10 w-14 shrink-0 items-center justify-center rounded-lg border border-line bg-card font-display text-sm font-bold text-accent">
                  {step.num}
                </span>
                <div>
                  <h3 class="text-lg">{step.title}</h3>
                  <p class="mt-1 text-sm text-muted">{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
