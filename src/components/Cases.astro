---
import { CASES, SITE } from "../data/site.js";
import Icon from "./Icon.astro";
---

<section id="cases" class="section-spacing">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Кейсы</p>
      <h2 class="text-3xl sm:text-4xl">Наши проекты</h2>
      <p class="mt-4 text-muted">
        {
          SITE.demoMode
            ? "Демонстрационные примеры структуры и подхода к работе. Будут заменены реальными проектами."
            : "Примеры проектов, которые мы разработали: от лендингов до корпоративных сайтов."
        }
      </p>
    </div>

    <div class="mt-10 grid gap-5 max-w-2xl mx-auto">
      {
        CASES.map((item, index) => (
          <article class="card group flex flex-col overflow-hidden p-0">
            <div class="mockup relative aspect-[16/10] overflow-hidden">
              <img src={item.images[0]} alt={item.title} class="absolute inset-0 h-full w-full object-cover object-top" loading="lazy" />
              {SITE.demoMode ? (
                <span class="demo-badge absolute left-4 top-4 z-10">Демонстрационный материал</span>
              ) : null}
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-xl">{item.title}</h3>
              <ul class="mt-3 flex flex-1 flex-col gap-1.5 text-sm text-muted">
                {
                  item.works.map((w) => (
                    <li class="flex items-start gap-2">
                      <Icon name="check" size={16} class="mt-0.5 text-accent2" />
                      {w}
                    </li>
                  ))
                }
              </ul>
              <button
                type="button"
                class="btn btn-ghost btn-sm mt-5 w-full"
                data-open-case={index}
                aria-haspopup="dialog"
              >
                Подробнее
              </button>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<dialog id="case-modal" aria-labelledby="case-modal-title">
  <div class="flex max-h-[85dvh] flex-col overflow-hidden">
    <div class="flex shrink-0 items-start justify-between gap-4 border-b border-line p-6">
      <div class="min-w-0">
        <p id="case-chip" class="eyebrow mb-2 text-accent2"></p>
        <h3 id="case-modal-title" class="text-2xl"></h3>
      </div>
      <button
        type="button"
        data-close-case
        class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-edge text-body transition hover:text-heading"
        aria-label="Закрыть"
      >
        <Icon name="close" size={20} />
      </button>
    </div>

    <div class="min-h-0 flex-1 overflow-y-auto p-6">
      <div class="mockup relative aspect-[16/10] overflow-hidden">
        <div id="case-slider" class="flex h-full transition-transform duration-300"></div>
        <button data-slider-prev class="absolute left-2 top-1/2 -translate-y-1/2 flex h-9 w-9 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur-sm transition hover:bg-black/60" aria-label="Назад">
          <Icon name="chevronLeft" size={20} />
        </button>
        <button data-slider-next class="absolute right-2 top-1/2 -translate-y-1/2 flex h-9 w-9 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur-sm transition hover:bg-black/60" aria-label="Вперёд">
          <Icon name="chevronRight" size={20} />
        </button>
        <div id="case-dots" class="absolute bottom-3 left-1/2 flex -translate-x-1/2 gap-2"></div>
      </div>

      <div class="mt-6 grid gap-6">
        <section>
          <h4 class="text-lg">Задача</h4>
          <p id="case-task" class="mt-2 text-muted"></p>
        </section>
        <section>
          <h4 class="text-lg">Что сделали</h4>
          <ul id="case-works" class="mt-2 flex flex-col gap-2 text-muted"></ul>
        </section>
        <section>
          <h4 class="text-lg">Результат</h4>
          <p id="case-result" class="mt-2 text-muted"></p>
        </section>
      </div>

      <blockquote class="mt-6 rounded-2xl border border-edge bg-section/60 p-5">
        <p id="case-review" class="italic text-body"></p>
        <footer id="case-author" class="mt-3 text-sm font-semibold text-muted"></footer>
        {SITE.demoMode ? <p class="mt-2 demo-badge w-fit">Демонстрационный отзыв</p> : null}
      </blockquote>
    </div>

    <div class="flex shrink-0 flex-col gap-3 border-t border-line p-6 sm:flex-row">
      <a href="#contacts" class="btn btn-primary flex-1">Обсудить похожий проект</a>
      <button type="button" data-close-case class="btn btn-neutral">Закрыть</button>
    </div>
  </div>
</dialog>

<script type="application/json" id="cases-data" set:html={JSON.stringify(CASES)} />

<script>
  const modal = document.getElementById("case-modal") as HTMLDialogElement | null;
  const data = JSON.parse(
    (document.getElementById("cases-data") as HTMLElement | null)?.textContent ?? "[]"
  ) as Array<Record<string, any>>;

  if (modal) {
    document.querySelectorAll<HTMLButtonElement>("[data-open-case]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const item = data[Number(btn.dataset.openCase)];
        if (!item) return;
        fill(item);
        modal.showModal();
      });
    });

    document.querySelectorAll<HTMLElement>("[data-close-case]").forEach((btn) => {
      btn.addEventListener("click", () => modal.close());
    });

    modal.addEventListener("click", (e) => {
      if (e.target === modal) modal.close();
    });

    modal.querySelector("a[href='#contacts']")?.addEventListener("click", () => modal.close());
  }

  function fill(item: Record<string, any>) {
    const set = (id: string, text: string) => {
      const el = modal?.querySelector<HTMLElement>(`#${id}`);
      if (el) el.textContent = text;
    };
    set("case-chip", item.type);
    set("case-modal-title", item.title);
    set("case-niche", item.niche);
    set("case-type", item.type);
    set("case-task", item.task);
    set("case-result", item.result);
    set("case-review", `«${item.review}»`);
    set("case-author", `— ${item.author}`);

    const images: string[] = item.images ?? [item.image].filter(Boolean);
    let currentSlide = 0;

    const slider = modal?.querySelector<HTMLElement>("#case-slider");
    const dots = modal?.querySelector<HTMLElement>("#case-dots");
    const prevBtn = modal?.querySelector<HTMLButtonElement>("[data-slider-prev]");
    const nextBtn = modal?.querySelector<HTMLButtonElement>("[data-slider-next]");

    if (slider) {
      slider.innerHTML = images
        .map(
          (src: string) =>
            `<img src="${src}" alt="${item.title}" class="h-full w-full shrink-0 object-cover object-top" />`
        )
        .join("");
    }
    if (dots) {
      dots.innerHTML = images
        .map(
          (_: string, i: number) =>
            `<button data-slide="${i}" class="h-2 w-2 rounded-full transition ${
              i === 0 ? "bg-white" : "bg-white/40"
            }"></button>`
        )
        .join("");
    }

    const showSlide = (idx: number) => {
      currentSlide = idx;
      if (slider) slider.style.transform = `translateX(-${idx * 100}%)`;
      dots?.querySelectorAll("button").forEach((b, i) => {
        b.className = `h-2 w-2 rounded-full transition ${i === idx ? "bg-white" : "bg-white/40"}`;
      });
    };

    prevBtn?.addEventListener("click", () => showSlide((currentSlide - 1 + images.length) % images.length));
    nextBtn?.addEventListener("click", () => showSlide((currentSlide + 1) % images.length));
    dots?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-slide]");
      if (btn) showSlide(Number(btn.dataset.slide));
    });

    const navHidden = images.length < 2;
    prevBtn?.classList.toggle("hidden", navHidden);
    nextBtn?.classList.toggle("hidden", navHidden);
    dots?.classList.toggle("hidden", navHidden);

    showSlide(0);

    const works = modal?.querySelector<HTMLElement>("#case-works");
    if (works) {
      works.innerHTML = item.works
        .map(
          (w: string) =>
            `<li class="flex items-start gap-2"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#a855f7" stroke-width="2" class="mt-1 shrink-0"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12l5 5L20 7"/></svg>${w}</li>`
        )
        .join("");
    }
  }
</script>