---
import { CASES } from "../data/site.js";
import Icon from "./Icon.astro";
---

<section id="cases" class="section-spacing">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Кейс</p>
      <h2 class="text-3xl sm:text-4xl">Как мы построили сайт для школы маникюра</h2>
      <p class="mt-4 text-muted">
        Реальный проект: от разбора задачи до запуска работающего сайта.
      </p>
    </div>

    {
      CASES.map((item) => (
        <article id="case-{item.title}" class="card mt-10 overflow-hidden">
          <div class="grid gap-0 lg:grid-cols-2">
            <!-- Screenshots -->
            <div class="mockup relative aspect-[16/10] overflow-hidden">
              <img
                src={item.images[0]}
                alt={item.title}
                class="absolute inset-0 h-full w-full object-cover object-top"
                loading="lazy"
              />
            </div>

            <!-- Content -->
            <div class="flex flex-col p-6 sm:p-8">
              <div class="flex items-center gap-2">
                <span class="chip">{item.type}</span>
                <span class="chip">{item.niche}</span>
              </div>

              <h3 class="mt-4 text-2xl">{item.title}</h3>

              <section class="mt-5">
                <h4 class="font-display text-sm font-bold uppercase tracking-wide text-muted">Задача</h4>
                <p class="mt-2 text-body">{item.task}</p>
              </section>

              <ul class="mt-5 grid gap-3 sm:grid-cols-2">
                {
                  item.works.map((w) => (
                    <li class="flex items-start gap-3">
                      <Icon name="check" size={18} class="mt-0.5 shrink-0 text-accent" />
                      <div>
                        <p class="font-display text-sm font-bold text-heading">{w.title}</p>
                        <p class="mt-0.5 text-sm text-muted">{w.text}</p>
                      </div>
                    </li>
                  ))
                }
              </ul>

              <section class="mt-5 border-t border-line pt-5">
                <h4 class="font-display text-sm font-bold uppercase tracking-wide text-muted">Результат</h4>
                <p class="mt-2 text-body">{item.result}</p>
              </section>

              <a href="#lead-form" class="btn btn-primary mt-6" data-goal="case_view">{item.cta}</a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
