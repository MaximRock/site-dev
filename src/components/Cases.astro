---
import { CASES, REVIEWS } from "../data/site.js";
import Icon from "./Icon.astro";

const review = REVIEWS[0];
---

<section id="cases" class="section-spacing">
  <div class="container-x">
    <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow mb-4">Кейсы</p>
        <h2 class="text-3xl sm:text-4xl">Работы, в которых видно подход</h2>
        <p class="mt-4 text-muted">
          Не шаблоны, а решения под задачу: от структуры и текста до визуального языка.
          Смотрите, как одна и та же логика работает в разных нишах.
        </p>
      </div>
      <div class="flex flex-col gap-5 lg:items-end">
        <p class="max-w-sm text-sm text-muted">
          Каждый проект начинается с разбора бизнеса. Поэтому у пекарни, школы маникюра
          и кофейни получились разные сайты, а не одна тема с заменённым логотипом.
        </p>
        <div class="case-controls">
          <p class="case-counter" data-case-counter>01 / 02</p>
          <div class="flex items-center gap-2">
            <button
              type="button"
              class="case-nav-btn"
              data-case-prev
              aria-label="Предыдущие кейсы"
              disabled
            >
              <Icon name="chevronLeft" size={20} />
            </button>
            <button
              type="button"
              class="case-nav-btn"
              data-case-next
              aria-label="Следующие кейсы"
            >
              <Icon name="chevronRight" size={20} />
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="cases-viewport mt-10">
      <div
        class="cases-rail"
        data-cases-rail
        tabindex="0"
        role="region"
        aria-label="Лента кейсов"
      >
        {
          CASES.map((item, i) => (
            <article class="card case-card" data-case-card>
              <div class="case-media">
                <img
                  src={item.desktop[0]}
                  alt={`${item.title}: главный экран для компьютера`}
                  width="1835"
                  height="950"
                  loading="lazy"
                />
                <figure class="case-phone">
                  <img
                    src={item.mobile[0]}
                    alt={`${item.title}: мобильная версия`}
                    width="364"
                    height="748"
                    loading="lazy"
                  />
                </figure>
                <span class="case-index" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
              </div>

              <div class="case-body">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="chip">{item.type}</span>
                  <span class="chip">{item.niche}</span>
                </div>
                <h3 class="mt-4 text-2xl">{item.title}</h3>
                <p class="mt-3 text-body">{item.summary}</p>
                <div class="case-actions">
                  <a
                    href="#contacts"
                    class="btn btn-primary"
                    data-goal="case_view"
                  >
                    {item.cta}
                  </a>
                  {item.siteUrl ? (
                    <a
                      href={item.siteUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-ghost"
                      data-goal="case_site"
                    >
                      Перейти на сайт
                      <Icon name="arrowRight" size={16} />
                    </a>
                  ) : (
                    <button
                      type="button"
                      class="btn btn-ghost case-site-stub"
                      disabled
                      title="Ссылка появится после публикации кейса"
                    >
                      Перейти на сайт
                    </button>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    {
      review && (
        <figure class="card review-card mt-6">
          <div class="flex flex-wrap items-center gap-3">
            <span class="review-initial" aria-hidden="true">
              {review.author[0]}
            </span>
            <figcaption>
              <p class="font-display font-bold text-heading">{review.author}</p>
              <p class="text-sm text-muted">{review.meta}</p>
            </figcaption>
            <span class="review-stars ml-auto" role="img" aria-label="Оценка: пять из пяти">
              {Array.from({ length: 5 }).map(() => (
                <Icon name="star" size={16} />
              ))}
            </span>
          </div>
          <blockquote class="mt-5 max-w-3xl text-lg leading-relaxed text-body">
            «{review.text}»
          </blockquote>
        </figure>
      )
    }
  </div>
</section>

<script>
  const rail = document.querySelector<HTMLElement>("[data-cases-rail]");
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-case-prev]");
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-case-next]");
  const counter = document.querySelector<HTMLElement>("[data-case-counter]");
  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-case-card]"),
  );
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (rail && prevBtn && nextBtn && counter && cards.length > 0) {
    const pad = (value: number) => String(value).padStart(2, "0");

    const positions = () => {
      const base = cards[0].offsetLeft;
      return cards.map((card) => card.offsetLeft - base);
    };

    const indexAtStart = () => {
      const list = positions();
      let index = 0;
      let nearest = Number.POSITIVE_INFINITY;
      for (let i = 0; i < list.length; i += 1) {
        const distance = Math.abs(list[i] - rail.scrollLeft);
        if (distance < nearest) {
          nearest = distance;
          index = i;
        }
      }
      return index;
    };

    const perView = () => {
      const list = positions();
      const step =
        list.length > 1 ? list[1] - list[0] : cards[0].offsetWidth;
      if (step <= 0) return 1;
      const gap = Number.parseFloat(getComputedStyle(rail).columnGap) || 0;
      return Math.max(1, Math.round((rail.clientWidth + gap) / step));
    };

    const update = () => {
      const index = indexAtStart();
      const last = Math.min(index + perView(), cards.length);
      counter.textContent =
        index + 1 === last
          ? `${pad(index + 1)} / ${pad(cards.length)}`
          : `${pad(index + 1)}–${pad(last)} / ${pad(cards.length)}`;
      prevBtn.disabled = rail.scrollLeft <= 1;
      nextBtn.disabled =
        rail.scrollLeft >= rail.scrollWidth - rail.clientWidth - 1;
    };

    const go = (direction: number) => {
      const list = positions();
      const index = Math.min(
        Math.max(indexAtStart() + direction, 0),
        cards.length - 1,
      );
      rail.scrollTo({
        left: list[index],
        behavior: reduceMotion.matches ? "auto" : "smooth",
      });
    };

    let frame = 0;
    rail.addEventListener(
      "scroll",
      () => {
        if (frame) return;
        frame = window.requestAnimationFrame(() => {
          frame = 0;
          update();
        });
      },
      { passive: true },
    );

    rail.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        go(1);
      }
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        go(-1);
      }
    });

    prevBtn.addEventListener("click", () => go(-1));
    nextBtn.addEventListener("click", () => go(1));
    window.addEventListener("resize", update);

    update();
  }
</script>

<style>
  .case-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .case-counter {
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .case-nav-btn {
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-control);
    background: var(--color-card);
    color: var(--color-heading);
    cursor: pointer;
    transition:
      background-color var(--motion-fast) ease,
      border-color var(--motion-fast) ease,
      color var(--motion-fast) ease;
  }

  .case-nav-btn:hover:not(:disabled) {
    border-color: var(--color-heading);
    background: var(--color-card-hover);
  }

  .case-nav-btn:active:not(:disabled) {
    transform: translateY(1px);
  }

  .case-nav-btn:disabled {
    border-color: var(--color-line);
    color: var(--color-muted);
    cursor: not-allowed;
    opacity: 0.55;
  }

  .cases-viewport {
    position: relative;
  }

  .cases-rail {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .cases-rail::-webkit-scrollbar {
    display: none;
  }

  .cases-rail:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-heading);
    outline-offset: var(--focus-ring-offset);
    border-radius: var(--radius-card);
  }

  .case-card {
    display: flex;
    flex: 0 0 85%;
    flex-direction: column;
    overflow: hidden;
    scroll-snap-align: start;
  }

  .case-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.25rem;
  }

  .case-media {
    position: relative;
    aspect-ratio: 1835 / 950;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--gradient-panel);
  }

  .case-media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .case-phone {
    position: absolute;
    right: clamp(0.75rem, 3vw, 1.5rem);
    bottom: clamp(0.75rem, 3vw, 1.5rem);
    width: clamp(3.75rem, 15%, 7rem);
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-control);
    box-shadow: 0 12px 30px -12px var(--color-shadow);
    background: var(--color-card);
  }

  .case-phone img {
    width: 100%;
    height: auto;
    display: block;
  }

  .case-index {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-chip);
    background: var(--color-deep);
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .case-actions {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .case-actions .btn {
    width: 100%;
    justify-content: center;
  }

  .case-site-stub:disabled {
    border-color: var(--color-line);
    background: transparent;
    color: var(--color-muted);
  }

  .review-card {
    padding: 1.5rem;
  }

  .review-initial {
    display: flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-control);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .review-stars {
    display: inline-flex;
    gap: 0.125rem;
    color: var(--color-accent);
  }

  @media (min-width: 1024px) {
    .case-card {
      flex-basis: calc((100% - 1.5rem) / 2);
    }
  }
</style>
