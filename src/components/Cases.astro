---
import { CASES, REVIEWS } from "../data/site.js";
import Icon from "./Icon.astro";

const review = REVIEWS[0];
---

<section id="cases" class="section-spacing">
  <div class="container-x">
    <div class="grid gap-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow mb-4">Кейсы</p>
        <h2 class="text-3xl sm:text-4xl">Два проекта, в которых видно подход</h2>
        <p class="mt-4 text-muted">
          Не шаблоны, а решения под задачу: от структуры и текста до визуального языка.
          Смотрите, как одна и та же логика работает в разных нишах.
        </p>
      </div>
      <p class="max-w-sm text-sm text-muted lg:justify-self-end">
        Каждый проект начинается с разбора бизнеса. Поэтому у кофейни и школы маникюра
        получились разные сайты, а не одна тема с заменённым логотипом.
      </p>
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {
        CASES.map((item, i) => (
          <article class="card case-card">
            <div class="case-media">
              <img
                src={item.desktop[0]}
                alt={`${item.title}: главный экран для компьютера`}
                width="1835"
                height="950"
                loading="lazy"
              />
              <figure class="case-phone">
                <img
                  src={item.mobile[0]}
                  alt={`${item.title}: мобильная версия`}
                  width="364"
                  height="748"
                  loading="lazy"
                />
              </figure>
              <span class="case-index" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>

            <div class="case-body">
              <div class="flex flex-wrap items-center gap-2">
                <span class="chip">{item.type}</span>
                <span class="chip">{item.niche}</span>
              </div>
              <h3 class="mt-4 text-2xl">{item.title}</h3>
              <p class="mt-3 text-body">{item.summary}</p>
              <a href="#contacts" class="btn btn-primary mt-6" data-goal="case_view">
                Хочу такой же подход
              </a>
            </div>
          </article>
        ))
      }
    </div>

    {
      review && (
        <figure class="card review-card mt-6">
          <div class="flex flex-wrap items-center gap-3">
            <span class="review-initial" aria-hidden="true">
              {review.author[0]}
            </span>
            <figcaption>
              <p class="font-display font-bold text-heading">{review.author}</p>
              <p class="text-sm text-muted">{review.meta}</p>
            </figcaption>
            <span class="review-stars ml-auto" role="img" aria-label="Оценка: пять из пяти">
              {Array.from({ length: 5 }).map(() => (
                <Icon name="star" size={16} />
              ))}
            </span>
          </div>
          <blockquote class="mt-5 max-w-3xl text-lg leading-relaxed text-body">
            «{review.text}»
          </blockquote>
        </figure>
      )
    }
  </div>
</section>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .case-media {
    position: relative;
    aspect-ratio: 1835 / 950;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background: var(--gradient-panel);
  }

  .case-media > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .case-phone {
    position: absolute;
    right: clamp(0.75rem, 3vw, 1.5rem);
    bottom: clamp(0.75rem, 3vw, 1.5rem);
    width: clamp(3.75rem, 15%, 7rem);
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-control);
    box-shadow: 0 12px 30px -12px var(--color-shadow);
    background: var(--color-card);
  }

  .case-phone img {
    width: 100%;
    height: auto;
    display: block;
  }

  .case-index {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-chip);
    background: var(--color-deep);
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .case-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.25rem;
  }

  .case-body .btn {
    align-self: stretch;
    justify-content: center;
  }

  .review-card {
    padding: 1.5rem;
  }

  .review-initial {
    display: flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-control);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-display);
    font-weight: 700;
  }

  .review-stars {
    display: inline-flex;
    gap: 0.125rem;
    color: var(--color-accent);
  }

  @media (min-width: 640px) {
    .review-card {
      padding: 2rem;
    }
  }
</style>
