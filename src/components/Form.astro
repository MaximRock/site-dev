---
import { FORM_OPTIONS } from "../data/site.js";
import Icon from "./Icon.astro";
---

<section id="contacts" class="section-spacing">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow mb-4">Заявка</p>
      <h2 class="text-3xl sm:text-4xl">Расскажите о проекте</h2>
    </div>

    <!-- Form -->
    <form
      id="lead-form"
      class="card mx-auto mt-10 max-w-2xl p-6 sm:p-9"
      novalidate
      aria-describedby="form-status"
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="f-name" class="field-label">Ваше имя <span class="text-accent" aria-hidden="true">*</span></label>
          <input
            id="f-name"
            name="name"
            type="text"
            placeholder="Как к вам обращаться?"
            class="field"
            autocomplete="name"
            aria-required="true"
            aria-describedby="f-name-error"
          />
          <p id="f-name-error" class="mt-1.5 hidden text-sm text-error" data-field-error="name"></p>
        </div>

        <div>
          <label for="f-contact" class="field-label">Телефон / Telegram <span class="text-accent" aria-hidden="true">*</span></label>
          <input
            id="f-contact"
            name="contact"
            type="text"
            placeholder="+7 ... / @username"
            class="field"
            autocomplete="tel"
            aria-required="true"
            aria-describedby="f-contact-error"
          />
          <p id="f-contact-error" class="mt-1.5 hidden text-sm text-error" data-field-error="contact"></p>
        </div>
      </div>

      <div class="mt-5">
        <label for="f-subject" class="field-label">Что нужно сделать?</label>
        <select id="f-subject" name="subject" class="field">
          {
            FORM_OPTIONS.map((opt) => (
              <option value={opt.value} class="bg-card">{opt.label}</option>
            ))
          }
        </select>
      </div>

      <div class="mt-5">
        <label for="f-comment" class="field-label">
          Комментарий <span class="font-normal text-muted">(необязательно)</span>
        </label>
        <textarea
          id="f-comment"
          name="comment"
          rows={3}
          placeholder="Коротко расскажите о задаче"
          class="field"
          aria-describedby="f-comment-error"
        ></textarea>
        <p id="f-comment-error" class="mt-1.5 hidden text-sm text-error" data-field-error="comment"></p>
      </div>

      <div class="mt-5 flex items-start gap-3">
        <input
          id="f-consent"
          name="consent"
          type="checkbox"
          class="mt-1 h-5 w-5 shrink-0 accent-[#8b5cf6]"
          aria-required="true"
          aria-describedby="f-consent-error"
        />
        <label for="f-consent" class="text-sm text-muted">
          Я согласен на обработку персональных данных. Подробнее в
          <a href="/privacy" target="_blank" rel="noopener" class="text-accent underline underline-offset-2 hover:text-accent2">
            политике конфиденциальности
          </a>.
        </label>
      </div>
      <p id="f-consent-error" class="mt-1.5 hidden text-sm text-error" data-field-error="consent"></p>

      <button id="submit-btn" type="submit" class="btn btn-primary mt-6 w-full">
        Получить бесплатный разбор
      </button>

      <p
        id="form-status"
        role="status"
        aria-live="polite"
        class="mt-4 hidden rounded-xl px-4 py-3 text-center text-sm font-medium"
      ></p>
    </form>

    <!-- Success state -->
    <div
      id="form-success"
      hidden
      class="card mx-auto mt-10 max-w-2xl p-8 sm:p-12 text-center"
      role="status"
      aria-live="polite"
    >
      <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-success/15 text-success">
        <Icon name="check" size={32} />
      </div>
      <h3 class="mt-6 text-2xl">Заявка отправлена</h3>
      <p class="mt-3 text-muted">
        Спасибо! Мы получили вашу заявку. Свяжемся с вами в течение рабочего дня и договоримся о
        времени бесплатного разбора.
      </p>
    </div>
  </div>
</section>

<script>
  import confetti from "canvas-confetti";

  const form = document.getElementById("lead-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status") as HTMLElement | null;
  const success = document.getElementById("form-success") as HTMLElement | null;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

  function setStatus(message: string, kind: "success" | "error") {
    if (!status) return;
    status.classList.remove("hidden", "bg-success/15", "text-success", "bg-error/15", "text-error");
    status.classList.add(kind === "success" ? "bg-success/15 text-success" : "bg-error/15 text-error");
    status.textContent = message;
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (!form || !status) return;
    const data = new FormData(form);

    const name = String(data.get("name") ?? "").trim();
    const contact = String(data.get("contact") ?? "").trim();
    const consent = data.get("consent") === "on";

    let firstError: HTMLElement | null = null;
    const errors: Record<string, string> = {};

    form.querySelectorAll<HTMLElement>(".field-error").forEach((el) => el.classList.remove("field-error"));
    form.querySelectorAll<HTMLElement>("[data-field-error]").forEach((el) => {
      el.textContent = "";
      el.classList.add("hidden");
    });
    form.querySelectorAll<HTMLElement>("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));

    if (!name) errors.name = "Введите имя";
    if (!contact) errors.contact = "Укажите телефон или Telegram";
    else if (contact.length < 6) errors.contact = "Контакт слишком короткий";
    if (!consent) errors.consent = "Нужно согласие на обработку данных";

    Object.keys(errors).forEach((id) => {
      const input = form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${id}"]`);
      const errEl = form.querySelector<HTMLElement>(`[data-field-error="${id}"]`);
      if (input && errEl) {
        input.classList.add("field-error");
        input.setAttribute("aria-invalid", "true");
        errEl.textContent = errors[id];
        errEl.classList.remove("hidden");
        if (!firstError) firstError = input;
      }
    });

    if (Object.keys(errors).length > 0) {
      firstError?.focus();
      setStatus("Проверьте выделенные поля", "error");
      return;
    }

    submitBtn!.disabled = true;
    submitBtn.textContent = "Отправляем...";
    setStatus("", "success");

    setTimeout(() => {
      ;(window as any).__track?.("form_submit");
      form.hidden = true;
      if (success) success.hidden = false;
      success?.scrollIntoView({ behavior: "smooth", block: "center" });

      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduceMotion) {
        confetti({ particleCount: 80, spread: 70, origin: { y: 0.7 }, colors: ["#8b5cf6", "#a855f7", "#ffffff"] });
      }
    }, 700);
  });

  form?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>("input, textarea, select").forEach((el) => {
    el.addEventListener("focus", () => (window as any).__track?.("form_start"), { once: true });
    el.addEventListener("input", () => {
      el.classList.remove("field-error");
      el.removeAttribute("aria-invalid");
      const errEl = form.querySelector<HTMLElement>(`[data-field-error="${el.name}"]`);
      if (errEl) {
        errEl.textContent = "";
        errEl.classList.add("hidden");
      }
    });
  });

  const consentEl = document.getElementById("f-consent") as HTMLInputElement | null;
  consentEl?.addEventListener("change", () => {
    consentEl.classList.remove("field-error");
    consentEl.removeAttribute("aria-invalid");
    const errEl = form?.querySelector<HTMLElement>(`[data-field-error="${consentEl.name}"]`);
    if (errEl) {
      errEl.textContent = "";
      errEl.classList.add("hidden");
    }
  });
</script>
