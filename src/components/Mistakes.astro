---
import { MISTAKES_CARDS } from "../data/site.js";
---

<section class="section-spacing">
  <div class="container-x grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
    <div>
      <p class="eyebrow mb-4">Чек-лист</p>
      <h2 class="text-3xl sm:text-4xl">Пять признаков, что сайту нужна работа</h2>
      <p class="mt-4 max-w-prose text-muted">
        Пройдите по списку и отметьте, что уже есть на вашем сайте.
      </p>
    </div>

    <ol class="card flex flex-col divide-y divide-edge">
      {
        MISTAKES_CARDS.map((item) => (
          <li class="flex items-start gap-4 p-5 sm:p-6">
            <span class="font-display text-lg font-bold text-accent-link">
              {item.num}
            </span>
            <p class="text-body">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
