---
import { REVIEWS } from "../data/site.js";
import Icon from "./Icon.astro";
---

<section id="reviews" class="section-spacing">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Отзыв</p>
      <h2 class="text-3xl sm:text-4xl">Реальный отзыв клиента</h2>
    </div>

    <div class="mt-10 max-w-3xl">
      {
        REVIEWS.map((review) => (
          <figure class="card flex flex-col p-7 sm:p-8">
            <div class="flex items-center gap-4">
              <div
                class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-accent to-accent-blue font-display text-xl font-extrabold text-white"
                aria-hidden="true"
              >
                {review.author[0]}
              </div>
              <div>
                <p class="font-display font-bold text-heading">{review.author}</p>
                <p class="text-sm text-muted">{review.meta}</p>
              </div>
              <span class="chip ml-auto hidden sm:inline-flex">Школа маникюра</span>
            </div>

            <blockquote class="mt-6 flex-1 text-lg leading-relaxed text-body">
              «{review.text}»
            </blockquote>

            <figcaption class="mt-6 flex gap-1 text-warning" aria-label="Пять звёзд">
              {Array.from({ length: 5 }).map(() => (
                <Icon name="star" size={18} />
              ))}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <p class="mt-6 max-w-3xl text-sm text-muted">
      Мы не придумываем отзывы ради красивой цифры. Показываем реальные проекты и реальные впечатления клиентов.
    </p>
  </div>
</section>
