---
import { CONTACTS, NAV, NAV_DESKTOP } from "../data/site.js";
import Icon from "./Icon.astro";
import { Icon as BrandIcon } from "astro-icon/components";

const phone = CONTACTS.phone;
const phoneUrl = CONTACTS.phoneUrl;
const telegram = CONTACTS.telegram;
const whatsapp = CONTACTS.whatsapp;
---

<header
  class="sticky top-0 z-40 border-b border-line/60 bg-deep/70 backdrop-blur-xl transition-all duration-300"
>
  <div class="container-x flex items-center justify-between h-16 lg:h-18">
    <!-- Logo -->
    <a href="#top" class="flex items-center gap-2.5 shrink-0" aria-label="Дизайн + Код — на главную">
      <img
        src="/logo.png"
        alt="Логотип веб-студии «Дизайн + Код»"
        width="36"
        height="36"
        loading="eager"
        class="h-9 w-9 rounded-lg object-contain"
      />
      <span class="font-display text-base font-extrabold leading-none text-heading hidden sm:block">
        Дизайн <span class="text-accent">+</span> Код
      </span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-1" aria-label="Основная навигация">
      {
        NAV_DESKTOP.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-3 py-2 text-sm font-medium text-body transition-colors hover:text-heading"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Desktop right -->
    <div class="hidden lg:flex items-center gap-3">
      <a
        href={phoneUrl}
        class="flex items-center gap-2 font-display text-sm font-bold text-heading transition-colors hover:text-accent"
      >
        <span class="status-dot" aria-hidden="true"></span>
        {phone}
      </a>
      <div class="flex items-center gap-2">
        <a
          href={telegram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Telegram"
          class="text-[#229ED9] transition-opacity hover:opacity-80"
        >
          <BrandIcon name="simple-icons:telegram" size={22} />
        </a>
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="WhatsApp"
          class="text-[#25D366] transition-opacity hover:opacity-80"
        >
          <BrandIcon name="simple-icons:whatsapp" size={22} />
        </a>
      </div>
      <a href="#lead-form" class="btn btn-primary btn-sm">Получить бесплатный разбор</a>
    </div>

    <!-- Mobile toggle -->
    <button
      id="menu-toggle"
      type="button"
      class="inline-flex lg:hidden h-10 w-10 items-center justify-center rounded-lg border border-edge text-heading transition-colors hover:text-accent"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Открыть меню"
    >
      <Icon name="menu" class="h-5 w-5" />
    </button>
  </div>
</header>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  hidden
  class="fixed inset-0 z-50 flex flex-col bg-deep"
>
  <div class="flex items-center justify-between border-b border-edge px-5 h-16">
    <a href="#top" class="flex items-center gap-2.5" aria-label="Дизайн + Код — на главную">
      <img src="/logo.png" alt="Логотип" width="32" height="32" loading="eager" class="h-8 w-8 rounded-lg object-contain" />
      <span class="font-display text-base font-extrabold text-heading">Дизайн <span class="text-accent">+</span> Код</span>
    </a>
    <button id="menu-close" type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-edge text-heading transition-colors hover:text-accent" aria-label="Закрыть меню">
      <Icon name="close" size={20} />
    </button>
  </div>

  <nav aria-label="Мобильная навигация" class="flex flex-col justify-center px-5 py-4 flex-1">
    {
      NAV.map((item) => (
        <a
          href={item.href}
          class="rounded-lg px-3 py-3.5 text-base font-medium text-body transition-colors hover:text-heading"
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="flex flex-col gap-3 border-t border-edge p-5">
    <a href={phoneUrl} class="flex items-center gap-2 font-display text-sm font-bold text-heading">
      <span class="status-dot" aria-hidden="true"></span>
      {phone}
    </a>
    <div class="flex items-center gap-3">
      <a href={telegram} target="_blank" rel="noopener noreferrer" aria-label="Telegram" class="text-[#229ED9] transition-opacity hover:opacity-80">
        <BrandIcon name="simple-icons:telegram" size={24} />
      </a>
      <a href={whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="text-[#25D366] transition-opacity hover:opacity-80">
        <BrandIcon name="simple-icons:whatsapp" size={24} />
      </a>
    </div>
    <a href="#lead-form" class="btn btn-primary w-full">Получить бесплатный разбор</a>
  </div>
</div>

<div id="menu-backdrop" hidden class="fixed inset-0 z-[45] bg-deep/40 backdrop-blur-sm"></div>

<script>
  const toggle = document.getElementById("menu-toggle") as HTMLButtonElement | null;
  const menu = document.getElementById("mobile-menu") as HTMLElement | null;
  const backdrop = document.getElementById("menu-backdrop") as HTMLElement | null;

  const closeMenu = () => {
    if (!menu) return;
    menu.hidden = true;
    if (backdrop) backdrop.hidden = true;
    document.documentElement.style.overflow = "";
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Открыть меню");
  };

  const openMenu = () => {
    if (!menu) return;
    menu.hidden = false;
    if (backdrop) backdrop.hidden = false;
    document.documentElement.style.overflow = "hidden";
    toggle?.setAttribute("aria-expanded", "true");
    toggle?.setAttribute("aria-label", "Закрыть меню");
  };

  toggle?.addEventListener("click", () => {
    menu?.hidden ? openMenu() : closeMenu();
  });

  backdrop?.addEventListener("click", closeMenu);
  document.getElementById("menu-close")?.addEventListener("click", closeMenu);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeMenu(); });
  menu?.querySelectorAll("a").forEach((link) => { link.addEventListener("click", closeMenu); });
</script>
