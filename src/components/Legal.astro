---
import { LEGAL_POINTS } from "../data/site.js";
import Icon from "./Icon.astro";
---

<section class="section-spacing bg-section/50">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Законность и безопасность</p>
      <h2 class="text-3xl sm:text-4xl">Юридическая безопасность сайта</h2>
      <p class="mt-4 text-muted">
        Учитываем требования к персональным данным, лицензии и юридическую грамотность проекта.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        LEGAL_POINTS.map((point) => (
          <article class="card p-6 hover:bg-[#202025]">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent/15 text-accent2">
              <Icon name="shield" size={24} />
            </div>
            <h3 class="mt-4 text-lg">{point.title}</h3>
            <p class="mt-1.5 text-sm text-muted">{point.text}</p>
          </article>
        ))
      }
    </div>

    <p class="demo-badge mt-8">Юридические документы будут добавлены после подготовки</p>
  </div>
</section>