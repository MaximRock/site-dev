---

{
  name in paths ? (
    <svg
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      class={`shrink-0 ${className ?? ""}`}
      aria-hidden="true"
      set:html={paths[name]}
    />
  ) : null
}