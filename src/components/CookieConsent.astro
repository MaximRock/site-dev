---
import { COOKIE_CONSENT } from "../data/site.js";

const c = COOKIE_CONSENT;
---

{
  c.enabled && (
    <div
      id="cookie-consent"
      hidden
      data-storage-key={c.storageKey}
      role="dialog"
      aria-modal="true"
      aria-label="Согласие на использование cookie"
      class="fixed inset-x-0 bottom-[calc(5rem_+_env(safe-area-inset-bottom))] z-[60] px-3 lg:bottom-6 lg:px-4"
    >
      <div class="container-x">
        <div class="mx-auto max-w-3xl rounded-2xl border border-edge bg-deep/95 p-4 shadow-2xl backdrop-blur-lg">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
            <p class="text-sm text-body">
              {c.text}{" "}
              <a
                href={c.policyHref}
                class="text-accent-link underline underline-offset-2 transition hover:text-accent2"
              >
                {c.policyLabel}
              </a>.
            </p>
            <div class="flex shrink-0 flex-wrap gap-2">
              <button type="button" data-cookie-action="reject" class="btn btn-neutral btn-sm">
                {c.rejectAllLabel}
              </button>
              <button type="button" data-cookie-action="customize" class="btn btn-neutral btn-sm">
                {c.customizeLabel}
              </button>
              <button type="button" data-cookie-action="accept" class="btn btn-primary btn-sm">
                {c.acceptAllLabel}
              </button>
            </div>
          </div>

          <div data-cookie-panel hidden class="mt-4 border-t border-edge pt-4">
            <ul class="flex flex-col gap-4">
              {c.categories.map((cat) => (
                <li class="flex items-start gap-3">
                  <input
                    type="checkbox"
                    id={`cookie-cat-${cat.id}`}
                    data-cookie-cat={cat.id}
                    checked={cat.required}
                    disabled={cat.required}
                    style="accent-color: var(--color-accent)"
                    class="mt-1 h-4 w-4 shrink-0 disabled:opacity-60"
                  />
                  <label for={`cookie-cat-${cat.id}`} class="cursor-pointer select-none">
                    <span class="font-display text-sm font-semibold text-heading">{cat.title}</span>
                    <span class="block text-sm text-body">{cat.text}</span>
                  </label>
                </li>
              ))}
            </ul>
            <div class="mt-4 flex justify-end">
              <button type="button" data-cookie-action="save" class="btn btn-primary btn-sm">
                {c.saveLabel}
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  )
}

<script>
  const root = document.getElementById("cookie-consent");

  if (root) {
    const key = root.dataset.storageKey || "sl-cookie-consent";
    const panel = root.querySelector<HTMLElement>("[data-cookie-panel]");
    const inputs = Array.from(root.querySelectorAll<HTMLInputElement>("[data-cookie-cat]"));
    const input = (id: string) => inputs.find((el) => el.dataset.cookieCat === id);
    const analyticsInput = input("analytics");
    const webvisorInput = input("webvisor");

    const normalize = (prefs: any) => {
      const analytics = !!prefs?.analytics;
      return { necessary: true as const, analytics, webvisor: analytics && !!prefs?.webvisor };
    };

    const focusable = () =>
      Array.from(
        root.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter((el) => !el.closest("[hidden]"));

    let lastFocused: HTMLElement | null = null;

    const hide = () => {
      root.hidden = true;
      lastFocused?.focus({ preventScroll: true });
      lastFocused = null;
    };

    const show = () => {
      if (!root.hidden) return;
      lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      root.hidden = false;
      focusable()[0]?.focus({ preventScroll: true });
    };

    const read = () => {
      try {
        const raw = localStorage.getItem(key);
        return raw ? normalize(JSON.parse(raw)) : null;
      } catch {
        return null;
      }
    };

    const write = (prefs: any) => {
      const value = normalize(prefs);
      try {
        localStorage.setItem(key, JSON.stringify({ ...value, date: new Date().toISOString() }));
      } catch {}
      hide();
      window.dispatchEvent(new CustomEvent("cookie-consent-changed", { detail: value }));
    };

    const fillPanel = (prefs: { analytics: boolean; webvisor: boolean }) => {
      if (analyticsInput) analyticsInput.checked = prefs.analytics;
      if (webvisorInput) webvisorInput.checked = prefs.webvisor;
    };

    const readPanel = () => ({
      analytics: analyticsInput?.checked ?? false,
      webvisor: webvisorInput?.checked ?? false,
    });

    webvisorInput?.addEventListener("change", () => {
      if (webvisorInput.checked && analyticsInput) analyticsInput.checked = true;
    });
    analyticsInput?.addEventListener("change", () => {
      if (!analyticsInput.checked && webvisorInput) webvisorInput.checked = false;
    });

    root.querySelectorAll<HTMLElement>("[data-cookie-action]").forEach((btn) => {
      btn.addEventListener("click", () => {
        switch (btn.dataset.cookieAction) {
          case "accept":
            write({ analytics: true, webvisor: true });
            break;
          case "reject":
            write({ analytics: false, webvisor: false });
            break;
          case "customize": {
            fillPanel(read() || { analytics: false, webvisor: false });
            if (panel) {
              panel.hidden = !panel.hidden;
              if (panel.hidden) {
                btn.focus({ preventScroll: true });
              } else {
                panel
                  .querySelector<HTMLInputElement>("input:not([disabled])")
                  ?.focus({ preventScroll: true });
              }
            }
            break;
          }
          case "save":
            write(readPanel());
            break;
        }
      });
    });

    root.addEventListener("keydown", (event) => {
      if (event.key !== "Tab") return;
      const items = focusable();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    if (!read()) show();
  }
</script>
