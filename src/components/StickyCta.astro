<div
  id="sticky-cta"
  class="fixed inset-x-0 bottom-0 z-50 border-t border-edge bg-deep/90 backdrop-blur-md md:hidden"
>
  <div class="container-x pt-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))]">
    <a href="#contacts" class="btn btn-primary w-full">Получить консультацию</a>
  </div>
</div>

<script>
  const bar = document.getElementById("sticky-cta");
  const contacts = document.getElementById("contacts");

  if (bar && contacts && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          bar.hidden = entry.isIntersecting;
        }
      },
      { rootMargin: "0px 0px -20% 0px" }
    );
    observer.observe(contacts);
  }
</script>
