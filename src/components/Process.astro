---
import { PROCESS_STEPS } from "../data/site.js";
import Icon from "./Icon.astro";
---

<section id="process" class="section-spacing">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Как мы работаем</p>
      <h2 class="text-3xl sm:text-4xl">Шесть шагов от задачи до запуска</h2>
      <p class="mt-4 text-muted">
        Прозрачный процесс: вы всегда понимаете, что происходит с проектом на каждом этапе.
      </p>
    </div>

    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        PROCESS_STEPS.map((step) => (
          <li class="card group relative p-6 transition hover:border-accent/50 hover:bg-card-hover">
            <span class="font-display text-4xl font-extrabold text-edge transition group-hover:text-accent">
              {step.num}
            </span>
            <h3 class="mt-3 text-lg">{step.title}</h3>
            <p class="mt-1.5 text-sm text-muted">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <aside class="card mt-8 flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:p-7">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-accent/15 text-accent">
        <Icon name="clock" size={24} />
      </div>
      <div class="min-w-0 flex-1">
        <h3 class="text-lg">После запуска</h3>
        <p class="mt-1 text-sm text-muted">
          Сайт можно развивать: доработки, поддержка, новые страницы и функции.
        </p>
      </div>
      <a href="#lead-form" class="btn btn-ghost btn-sm shrink-0">
        Обсудить проект
      </a>
    </aside>
  </div>
</section>
