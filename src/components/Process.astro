---
import { STEPS } from "../data/site.js";
import Icon from "./Icon.astro";
---

<section id="process" class="section-spacing">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Как мы работаем</p>
      <h2 class="text-3xl sm:text-4xl">Семь этапов от анализа до запуска</h2>
      <p class="mt-4 text-muted">
        Прозрачный процесс: вы всегда знаете, что происходит с проектом на каждом этапе.
      </p>
    </div>

    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        STEPS.map((step, index) => (
          <li class="card relative p-6 hover:bg-[#202025]">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/15 font-display text-base font-extrabold text-accent2">
                {index + 1}
              </span>
              <h3 class="text-lg">{step.title}</h3>
            </div>
            <p class="mt-3 text-sm text-muted">{step.text}</p>
          </li>
        ))
      }
    </ol>

    <aside class="card mt-8 flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:p-7">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-accent/15 text-accent2">
        <Icon name="clock" size={24} />
      </div>
      <div class="min-w-0 flex-1">
        <h3 class="text-lg">После запуска</h3>
        <p class="mt-1 text-sm text-muted">
          Четыре раза в год бесплатно проводим аудит сайта и даем рекомендации по увеличению
          количества заявок.
        </p>
      </div>
      <a href="#contacts" class="btn btn-ghost btn-sm shrink-0">
        Обсудить проект
      </a>
    </aside>
  </div>
</section>