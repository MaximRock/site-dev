---
import { PROCESS_STEPS, WHAT_YOU_GET } from "../data/site.js";
import Icon from "./Icon.astro";
---

<section id="process" class="section-spacing">
  <div class="container-x grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
    <div>
      <p class="eyebrow mb-4">Как мы работаем</p>
      <h2 class="text-3xl sm:text-4xl">От задачи до запуска</h2>
      <p class="mt-4 max-w-prose text-muted">
        Начинаем не с дизайна, а с задачи. Сначала разбираемся, что нужно бизнесу,
        затем делаем структуру, дизайн и код.
      </p>
      <p class="mt-3 max-w-prose text-muted">
        Вы понимаете, что происходит на каждом этапе, и не платите за лишние работы.
      </p>
    </div>

    <div class="flex flex-col gap-6">
      <ol class="flex flex-col gap-3">
        {
          PROCESS_STEPS.map((step) => (
            <li class="card flex gap-4 p-5 sm:p-6">
              <span class="font-display text-lg font-bold text-accent-link">
                {step.num}
              </span>
              <div class="min-w-0">
                <h3 class="text-lg">{step.title}</h3>
                <p class="mt-1 text-sm text-muted">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <aside class="card p-5 sm:p-6">
        <h3 class="text-lg">Что входит в разработку</h3>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {
            WHAT_YOU_GET.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-body">
                <Icon name="check" size={17} class="mt-0.5 shrink-0 text-accent" />
                {item}
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</section>
