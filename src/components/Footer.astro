---
import { CONTACTS, NAV } from "../data/site.js";
import Icon from "./Icon.astro";
---

<footer class="border-t border-line bg-footer pt-16 pb-28 md:pb-10">
  <div class="container-x grid gap-12 md:grid-cols-[1.4fr_1fr] lg:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <a href="#top" class="flex items-center gap-3" aria-label="Дизайн плюс Код — на главную">
        <img
          src="/logo.png"
          alt="Логотип веб-студии «Дизайн + Код»"
          width="44"
          height="44"
          loading="lazy"
          class="h-11 w-11 rounded-xl object-contain"
        />
        <span class="font-display text-xl font-extrabold text-heading">
          Дизайн <span class="text-accent2">+</span> Код
        </span>
      </a>
      <p class="mt-5 max-w-sm text-muted">
        Создаем сайты, которые помогают бизнесу продавать. Работаем напрямую: над проектом только
        дизайнер и разработчик.
      </p>
    </div>

    <nav aria-label="Навигация в подвале">
      <h3 class="font-display text-sm font-bold uppercase tracking-wider text-heading">Меню</h3>
      <ul class="mt-4 space-y-2">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="text-body transition hover:text-accent2">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h3 class="font-display text-sm font-bold uppercase tracking-wider text-heading">Контакты</h3>
      <ul class="mt-4 space-y-3">
        <li>
          <a href={CONTACTS.phoneUrl} class="flex items-center gap-3 font-display font-bold text-heading transition hover:text-accent2">
            <Icon name="phone" size={20} class="text-accent2" />
            {CONTACTS.phone}
          </a>
        </li>
        <li>
          <a
            href={CONTACTS.telegram}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-3 text-body transition hover:text-accent2"
          >
            <Icon name="telegram" size={20} class="text-accent2" />
            Telegram
          </a>
        </li>
        <li>
          <a
            href={CONTACTS.emailUrl}
            class="flex items-center gap-3 text-body transition hover:text-accent2"
          >
            <Icon name="mail" size={20} class="text-accent2" />
            {CONTACTS.email}
          </a>
        </li>
      </ul>
      <p class="mt-5 text-sm text-muted">
        Юридические документы будут добавлены после подготовки.
      </p>
    </div>
  </div>

  <div class="container-x mt-12 border-t border-line pt-6">
    <p class="text-sm text-muted">© 2026 «Дизайн + Код». Все права защищены.</p>
  </div>
</footer>