---
import { CONTACTS, NAV } from "../data/site.js";
import Icon from "./Icon.astro";
import { Icon as BrandIcon } from "astro-icon/components";
---

<footer class="border-t border-line bg-footer pt-16 pb-28 md:pb-10">
  <div class="container-x grid gap-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1.2fr]">
    <!-- Left: brand + CTA -->
    <div>
      <a href="#top" class="flex items-center gap-3" aria-label="Дизайн + Код — на главную">
        <img
          src="/logo.png"
          alt="Логотип веб-студии «Дизайн + Код»"
          width="44"
          height="44"
          loading="lazy"
          class="h-11 w-11 rounded-xl object-contain"
        />
        <span class="font-display text-xl font-extrabold text-heading">
          Дизайн <span class="text-accent">+</span> Код
        </span>
      </a>
      <p class="mt-5 max-w-sm text-muted">
        Сайты, которые работают на бизнес.
      </p>
      <a href="#lead-form" class="btn btn-primary btn-sm mt-6">Получить бесплатный разбор</a>
    </div>

    <!-- Nav -->
    <nav aria-label="Навигация в подвале">
      <h3 class="font-display text-sm font-bold uppercase tracking-wider text-heading">Навигация</h3>
      <ul class="mt-4 space-y-2">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="text-body transition hover:text-accent">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Contacts -->
    <div>
      <h3 class="font-display text-sm font-bold uppercase tracking-wider text-heading">Контакты</h3>
      <ul class="mt-4 space-y-3">
        <li>
          <a href={CONTACTS.phoneUrl} class="flex items-center gap-3 font-display font-bold text-heading transition hover:text-accent">
            <Icon name="phone" size={20} class="text-accent" />
            {CONTACTS.phone}
          </a>
        </li>
        <li>
          <a href={CONTACTS.telegram} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-body transition hover:text-accent">
            <BrandIcon name="simple-icons:telegram" size={20} class="text-accent" />
            Telegram
          </a>
        </li>
        <li>
          <a href={CONTACTS.whatsapp} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-body transition hover:text-accent">
            <BrandIcon name="simple-icons:whatsapp" size={20} class="text-accent" />
            WhatsApp
          </a>
        </li>
        <li>
          <a href={CONTACTS.max} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-body transition hover:text-accent">
            <svg viewBox="0 0 500 500" class="h-6 w-6 shrink-0 text-accent" aria-hidden="true">
              <path fill="currentColor" fill-rule="evenodd" d="M253.223 398.85c-29.441 0-43.123-4.298-66.905-21.49-15.043 19.341-62.679 34.456-64.756 8.596 0-19.412-4.298-35.816-9.17-53.725C106.59 310.168 100 285.598 100 249.997 100 164.968 169.771 101 252.435 101c82.736 0 147.564 67.12 147.564 149.784.278 81.386-65.391 147.632-146.776 148.066m1.218-224.355c-40.258-2.077-71.633 25.788-78.582 69.484-5.73 36.175 4.442 80.229 13.109 82.522 4.155 1.002 14.613-7.45 21.132-13.969a74.5 74.5 0 0 0 36.39 12.966c41.713 2.006 77.356-29.75 80.157-71.418 1.63-41.756-30.487-77.123-72.206-79.513z" />
            </svg>
            Max
          </a>
        </li>
        <li>
          <a href={CONTACTS.emailUrl} class="flex items-center gap-3 text-body transition hover:text-accent">
            <Icon name="mail" size={20} class="text-accent" />
            {CONTACTS.email}
          </a>
        </li>
      </ul>
      <p class="mt-5 text-sm text-muted">
        <a href="/privacy" class="transition hover:text-accent">Политика конфиденциальности</a>
      </p>
    </div>
  </div>

  <div class="container-x mt-12 border-t border-line pt-6">
    <p class="text-sm text-muted">© 2026 «Дизайн + Код». Все права защищены.</p>
  </div>
</footer>