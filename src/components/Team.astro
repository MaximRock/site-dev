---
import { ADVANTAGES, TEAM } from "../data/site.js";
import Icon from "./Icon.astro";
---

<section id="about" class="section-spacing bg-section">
  <div class="container-x grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
    <div>
      <p class="eyebrow mb-4">О нас</p>
      <h2 class="text-3xl sm:text-4xl">Почему нам можно доверять</h2>
      <p class="mt-4 max-w-prose text-muted">
        Над проектом работают два специалиста. Вы общаетесь напрямую с
        исполнителями.
      </p>

      <ul class="mt-6 flex flex-col gap-3">
        {
          ADVANTAGES.slice(0, 3).map((item) => (
            <li class="flex items-start gap-3">
              <Icon name="check" size={18} class="mt-1 text-accent" />
              <div class="min-w-0">
                <h3 class="text-base">{item.title}</h3>
                <p class="mt-1 text-sm text-muted">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        TEAM.map((person) => (
          <article class="card flex flex-col gap-3 p-6">
            <div
              class="flex h-14 w-14 items-center justify-center rounded-[var(--radius-control)] bg-primary font-display text-xl font-bold text-on-primary"
              aria-hidden="true"
            >
              {person.name[0]}
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-wider text-muted">
                {person.role}
              </p>
              <h3 class="mt-1 text-lg">{person.name}</h3>
            </div>
            <ul class="flex flex-wrap gap-1.5">
              {
                person.focus.slice(0, 3).map((item) => (
                  <li class="chip !px-2 !py-0.5 text-xs">{item}</li>
                ))
              }
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
