---
import { TEAM } from "../data/site.js";
import Icon from "./Icon.astro";
---

<section id="about" class="section-spacing">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Команда</p>
      <h2 class="text-3xl sm:text-4xl">Вместе ведем проект от идеи до запуска</h2>
      <p class="mt-4 text-muted">
        Над проектом работают только два специалиста, поэтому вы всегда общаетесь
        напрямую с исполнителями.
      </p>
    </div>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {
        TEAM.map((person, index) => (
          <article class="card flex items-start gap-5 p-6 hover:bg-card-hover sm:items-center">
            <div
              class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-accent to-accent-blue font-display text-2xl font-extrabold text-white"
              aria-hidden="true"
            >
              {person.name[0]}
            </div>
            <div class="min-w-0">
              <p class="text-xs font-semibold uppercase tracking-wider text-muted">
                {person.role}
              </p>
              <h3 class="mt-1 text-xl">{person.name}</h3>
              <ul class="mt-2 flex flex-wrap gap-1.5">
                {
                  person.focus.slice(0, index % 2 === 0 ? 3 : 3).map((f) => (
                    <li class="chip !px-2 !py-0.5 text-xs">{f}</li>
                  ))
                }
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <aside class="card mt-8 flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:p-7">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-accent/15 text-accent">
        <Icon name="shield" size={24} />
      </div>
      <div class="min-w-0 flex-1">
        <h3 class="text-lg">Прозрачная работа</h3>
        <p class="mt-1 text-sm text-muted">
          Понимаете, что происходит на каждом этапе. Никаких тайных слоев и неожиданных
          затрат — всё обсуждаем заранее.
        </p>
      </div>
      <a href="#lead-form" class="btn btn-ghost btn-sm shrink-0">
        Познакомиться
      </a>
    </aside>
  </div>
</section>
