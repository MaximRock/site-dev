---
import Icon from "./Icon.astro";
---

<section id="top" class="relative overflow-hidden pt-24 pb-16 lg:pt-32 lg:pb-24">
  <!-- Background -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-32 right-[-12%] h-[540px] w-[540px] rounded-full bg-accent/25 blur-[130px]"></div>
    <div class="absolute bottom-[-22%] left-[-12%] h-[440px] w-[440px] rounded-full bg-accent-blue/15 blur-[130px]"></div>
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: linear-gradient(#8b5cf6 1px, transparent 1px), linear-gradient(90deg, #8b5cf6 1px, transparent 1px); background-size: 56px 56px"
    ></div>
  </div>

  <div class="container-x relative">
    <div class="hero-image-wrapper pointer-events-none hidden lg:absolute lg:right-0 lg:top-1/2 lg:-translate-y-1/2 lg:w-[56%] lg:-ml-28 lg:block"
      aria-hidden="true">
      <div class="hero-image-glow"></div>
      <img
        id="hero-img"
        src="/team_hero_services_00002_.webp"
        alt=""
        class="hero-image hero-anim-image"
        width="800"
        height="600"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </div>

    <div class="relative max-w-3xl">
      <!-- Eyebrow -->
      <p class="eyebrow mb-6 hero-anim" style="animation-delay: 0s">Веб-студия «Дизайн + Код»</p>

      <!-- H1 -->
      <h1 class="mb-6 hero-anim">
        Создаем сайты, которые<br />
        <span class="text-accent">приносят заявки</span>,<br />
        а не просто красиво выглядят
      </h1>

      <!-- Subtitle -->
      <p class="mb-8 max-w-xl text-lg text-body lg:text-xl hero-anim" style="animation-delay: 0.1s">
        Разрабатываем на <span class="font-semibold text-heading">Tilda</span> и
        <span class="font-semibold text-heading">индивидуальном коде</span>.
        Подбираем решение под задачи вашего бизнеса, чтобы сайт
        окупался и помогал увеличивать продажи.
      </p>

      <!-- CTA buttons -->
      <div class="flex flex-col gap-3 sm:flex-row hero-anim" style="animation-delay: 0.2s">
        <a href="#lead-form" class="btn btn-primary">
          <Icon name="gift" size={18} />
          Получить бесплатный разбор
        </a>
        <a href="#cases" class="btn btn-ghost">Смотреть кейсы</a>
      </div>

      <!-- Chips -->
      <ul class="mt-8 flex flex-wrap gap-2" aria-label="Направления">
        <li class="chip">Tilda</li>
        <li class="chip">Лендинги</li>
        <li class="chip">Многостраничные</li>
        <li class="chip">Индивидуальные</li>
      </ul>

      <!-- Review counter -->
      <div class="mt-8 flex items-center gap-3 text-sm text-muted">
        <div class="flex -space-x-2">
          <div class="h-8 w-8 rounded-full border-2 border-deep bg-accent/30 flex items-center justify-center text-xs font-bold text-accent">И</div>
          <div class="h-8 w-8 rounded-full border-2 border-deep bg-accent-blue/30 flex items-center justify-center text-xs font-bold text-accent-blue">М</div>
        </div>
        <div>
          <span class="text-heading font-semibold">12+</span> отзывов
        </div>
      </div>
    </div>

    <!-- Floating gift card -->
    <div class="card mt-10 flex items-center gap-4 p-4 lg:mt-0 lg:absolute lg:right-0 lg:bottom-8 lg:max-w-sm">
      <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-accent/15 text-accent">
        <Icon name="gift" size={24} />
      </div>
      <div class="min-w-0 flex-1">
        <p class="font-display font-bold text-heading">Подарок при заказе сайта</p>
        <p class="mt-1 text-sm text-muted">
          Чек-лист «50 ошибок на сайте, которые убивают заявки»
        </p>
      </div>
      <span class="demo-badge shrink-0 self-start sm:self-center">Материал готовится</span>
    </div>
  </div>
</section>

<script>
  const heroWrap = document.querySelector(".hero-image-wrapper") as HTMLElement | null;
  if (heroWrap) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const isDesktop = () => window.matchMedia("(min-width: 1024px)").matches;

    if (!reduceMotion && isDesktop()) {
      let ticking = false;
      window.addEventListener(
        "scroll",
        () => {
          if (!isDesktop()) return;
          if (!ticking) {
            window.requestAnimationFrame(() => {
              const offset = Math.min(Math.max(window.scrollY * 0.04, 0), 16);
              heroWrap.style.transform = `translateY(calc(-50% - ${offset}px))`;
              ticking = false;
            });
            ticking = true;
          }
        },
        { passive: true }
      );
    }
  }
</script>