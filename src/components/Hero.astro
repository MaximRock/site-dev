---
import { CASES } from "../data/site.js";

const coffee = CASES.find((item) => item.slug === "kofeynya") ?? CASES[0];
const school =
  CASES.find((item) => item.slug === "shkola-manikyura") ?? CASES[1] ?? CASES[0];

const mainImage = coffee.desktop[0];
const phoneImage = school.mobile[0];
---

<section id="top" class="hero">
  <div class="container-x hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow hero-anim">Веб-студия / дизайн и код</p>

      <h1 class="hero-anim" style="animation-delay: 60ms">
        Сайт, который<br />
        помогает бизнесу<br />
        <span class="hero__accent">получать заявки</span>
      </h1>

      <p class="hero__lead hero-anim" style="animation-delay: 120ms">
        Проектируем и собираем сайты для малого и среднего бизнеса. Структура,
        дизайн, разработка и запуск. На Tilda или на индивидуальном коде, под
        задачу бизнеса.
      </p>

      <div class="hero__actions hero-anim" style="animation-delay: var(--motion-base)">
        <a href="#contacts" class="btn btn-primary">Получить бесплатный разбор</a>
        <a href="#cases" class="hero__link">
          Смотреть кейсы
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <p class="hero__note hero-anim" style="animation-delay: 220ms">
        30 минут, без обязательств
      </p>

      <ul
        class="hero__proof hero-anim"
        style="animation-delay: 260ms"
        aria-label="Ключевые условия"
      >
        <li>Tilda и индивидуальный код</li>
        <li>Фиксированная смета</li>
        <li>Запуск от 7 дней</li>
      </ul>
    </div>

    <div class="hero__media hero-anim" style="animation-delay: var(--motion-fast)">
      <a
        class="hero__work"
        href="#cases"
        aria-label="Смотреть кейсы: кофейня и школа маникюра"
      >
        <figure class="hero__main">
          <img
            src={mainImage}
            alt="Пример дизайна сайта кофейни, главный экран"
            width="1835"
            height="950"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <span class="hero__badge">Пример</span>
        </figure>

        <figure class="hero__phone">
          <img
            src={phoneImage}
            alt="Пример дизайна сайта школы маникюра, мобильная версия"
            width="365"
            height="790"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="hero__captions">
          <p><span class="hero__index">01</span> Кофейня. Сайт с онлайн-меню</p>
          <p><span class="hero__index">02</span> Школа маникюра. Мобильная версия</p>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(2.5rem, 7vw, 4.5rem));
    padding-bottom: clamp(3.5rem, 8vw, 7rem);
  }

  .hero__grid {
    display: grid;
    gap: 2.5rem;
  }

  .hero__copy {
    min-width: 0;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-eyebrow);
  }

  .hero__eyebrow::before {
    content: "";
    width: 2.5rem;
    height: 2px;
    flex-shrink: 0;
    background: var(--color-brand);
  }

  .hero h1 {
    margin-top: 1.5rem;
  }

  .hero__accent {
    text-decoration: underline;
    text-decoration-color: var(--color-brand);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  .hero__lead {
    margin-top: 1.5rem;
    max-width: 40rem;
    color: var(--color-body);
    font-size: 1.0625rem;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      color var(--motion-fast) ease,
      border-color var(--motion-fast) ease;
  }

  .hero__link span {
    transition: transform var(--motion-fast) ease;
  }

  .hero__link:hover,
  .hero__link:focus-visible {
    color: var(--color-accent-link);
    border-color: var(--color-brand);
  }

  .hero__link:hover span,
  .hero__link:focus-visible span {
    transform: translateX(3px);
  }

  .hero__note {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin-top: 2.25rem;
    padding: 0;
    list-style: none;
    color: var(--color-body);
    font-size: 0.875rem;
  }

  .hero__proof li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero__proof li::before {
    content: "";
    width: 0.375rem;
    height: 0.375rem;
    flex-shrink: 0;
    background: var(--color-brand);
  }

  .hero__media {
    position: relative;
    min-width: 0;
  }

  .hero__work {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .hero__main {
    position: relative;
    margin: 0;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-media);
    background: var(--color-card);
    overflow: hidden;
  }

  .hero__main img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1835 / 950;
    object-fit: cover;
    object-position: top center;
    transition: transform 200ms ease;
  }

  .hero__work:hover .hero__main img {
    transform: scale(1.015);
  }

  .hero__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-chip);
    background: var(--color-deep);
    color: var(--color-heading);
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero__phone {
    position: absolute;
    top: 2rem;
    right: -0.75rem;
    width: 25%;
    margin: 0;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius-media);
    background: var(--color-deep);
    overflow: hidden;
    box-shadow: 0 0.75rem 2rem
      color-mix(in srgb, var(--color-shadow) 18%, transparent);
  }

  .hero__phone img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 365 / 790;
    object-fit: cover;
    object-position: top center;
  }

  .hero__captions {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 1.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .hero__captions p {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0;
  }

  .hero__index {
    flex-shrink: 0;
    color: var(--color-accent-link);
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .hero__actions {
      flex-direction: row;
      align-items: center;
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }

    .hero__lead {
      font-size: 1.125rem;
    }

    .hero__media {
      margin-top: 2.75rem;
    }
  }

  @media (max-width: 1023px) {
    .hero__phone {
      top: 1rem;
      right: -0.25rem;
      width: 28%;
    }
  }
</style>
