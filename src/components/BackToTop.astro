---
import Icon from "./Icon.astro";
---

<a
  id="back-to-top"
  href="#top"
  aria-label="Наверх"
  class="fixed right-[1.25rem] bottom-6 z-30 flex h-11 w-11 items-center justify-center rounded-xl border border-edge bg-deep/90 text-heading opacity-0 shadow-lg backdrop-blur transition-all duration-300 hover:border-accent hover:text-accent pointer-events-none translate-y-2"
  data-visible="false"
>
  <Icon name="arrowUp" size={22} />
</a>

<script>
  const btn = document.getElementById("back-to-top");
  if (btn) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const showAt = 400;
    let visible = false;

    const setVisible = (next: boolean) => {
      if (next === visible) return;
      visible = next;
      btn.dataset.visible = String(next);
      btn.classList.toggle("pointer-events-none", !next);
      btn.classList.toggle("opacity-0", !next);
      btn.classList.toggle("translate-y-2", !next);
    };

    window.addEventListener(
      "scroll",
      () => {
        requestAnimationFrame(() => setVisible(window.scrollY > showAt));
      },
      { passive: true }
    );

    btn.addEventListener("click", (e) => {
      e.preventDefault();
      const behavior = reduceMotion ? "auto" : "smooth";
      try {
        window.scrollTo({ top: 0, behavior });
      } catch {
        window.scrollTo(0, 0);
      }
      history.replaceState(null, "", "#top");
    });
  }
</script>