const sections = [
  { id: "obshchie-polozheniya", title: "Общие положения" },
  { id: "chto-takoe-cookie", title: "Что такое cookie-файлы" },
  { id: "kategorii", title: "Какие cookie-файлы используются на Сайте" },
  { id: "celi", title: "Цели использования cookie-файлов" },
  { id: "sbor-informacii", title: "Сбор и обработка информации" },
  { id: "storonnie-servisy", title: "Использование сторонних сервисов" },
