import FinalCta from "../components/FinalCta.astro";

const title = "Дизайн + Код — создаем сайты, которые приносят заявки";
const description =
  "Веб-студия «Дизайн + Код»: лендинги и корпоративные сайты на Tilda и индивидуальном коде. Анализ, дизайн, разработка и запуск. Стоимость от 15 000 ₽. Консультация бесплатно.";
---

<Layout title={title} description={description}>
