---
import Layout from "../layouts/main.astro";
import Hero from "../components/Hero.astro";
import Mistakes from "../components/Mistakes.astro";
import Approach from "../components/Approach.astro";
import Services from "../components/Services.astro";
import Tech from "../components/Tech.astro";
import Calculator from "../components/Calculator.astro";
import Cases from "../components/Cases.astro";
import Price from "../components/Price.astro";
import Advantages from "../components/Advantages.astro";
import Team from "../components/Team.astro";
import Process from "../components/Process.astro";
import WhatYouGet from "../components/WhatYouGet.astro";
import LeadMagnet from "../components/LeadMagnet.astro";
import FreeDiagnosis from "../components/FreeDiagnosis.astro";
import Reviews from "../components/Reviews.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Form from "../components/Form.astro";

const title = "Дизайн + Код — создаем сайты, которые приносят заявки";
const description =
  "Веб-студия «Дизайн + Код»: лендинги и корпоративные сайты на Tilda и индивидуальном коде. Подбираем решение под задачи бизнеса. Бесплатный разбор за 30 минут.";
---

<Layout title={title} description={description}>
  <Hero />
  <Mistakes />
  <Approach />
  <Services />
  <Tech />
  <Calculator />
  <Cases />
  <Price />
  <Advantages />
  <Team />
  <Process />
  <WhatYouGet />
  <LeadMagnet />
  <FreeDiagnosis />
  <Reviews />
  <Faq />
  <FinalCta />
  <Form />
</Layout>
