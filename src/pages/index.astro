---
import Layout from "../layouts/main.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Quiz from "../components/Quiz.astro";
import Calculator from "../components/Calculator.astro";
import Cases from "../components/Cases.astro";
import Approach from "../components/Approach.astro";
import Price from "../components/Price.astro";
import Team from "../components/Team.astro";
import Advantages from "../components/Advantages.astro";
import Process from "../components/Process.astro";
import Legal from "../components/Legal.astro";
import Mistakes from "../components/Mistakes.astro";
import Tech from "../components/Tech.astro";
import Reviews from "../components/Reviews.astro";
