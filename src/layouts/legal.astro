---
import Layout from "./main.astro";
import Icon from "../components/Icon.astro";

export interface LegalSection {
  id: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  heading: string;
  dateLabel: string;
  dateValue: string;
  dateTime: string;
  sections: LegalSection[];
  related: { title: string; href: string; label: string };
}

const { title, description, heading, dateLabel, dateValue, dateTime, sections, related } =
  Astro.props;
---

<Layout title={title} description={description}>
  <article class="pt-28 pb-16 lg:pt-36 lg:pb-30">
    <div class="container-x">
      <header class="max-w-3xl">
        <p class="eyebrow mb-4">Правовая информация</p>
        <h1>{heading}</h1>
        <p class="mt-5 text-muted">
          {dateLabel}: <time datetime={dateTime}>{dateValue}</time>
        </p>
      </header>

      <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-start lg:gap-12">
        <div class="min-w-0 max-w-3xl">
          <details class="legal-toc card p-4 lg:hidden">
            <summary
              class="legal-toc__summary flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-display text-base font-semibold text-heading"
            >
              Содержание
              <Icon name="chevron" size={20} class="legal-toc__icon text-muted" />
            </summary>
            <nav aria-label="Содержание документа" class="mt-4">
              <ol class="space-y-2">
                {
                  sections.map((section, index) => (
                    <li>
                      <a
                        href={`#${section.id}`}
                        class="flex min-h-6 items-center gap-3 text-sm text-body transition hover:text-accent-link focus-visible:text-heading active:text-heading"
                      >
                        <span class="shrink-0 tabular-nums text-muted">
                          {String(index + 1).padStart(2, "0")}
                        </span>
                        <span>{section.title}</span>
                      </a>
                    </li>
                  ))
                }
              </ol>
            </nav>
          </details>

          <div class="legal-doc mt-8 lg:mt-0">
            <slot />
          </div>

          <aside class="mt-12 border border-edge bg-wash p-5" aria-labelledby="related-docs">
            <h2
              id="related-docs"
              class="flex items-center gap-2 font-display text-base font-semibold text-heading"
            >
              <Icon name="doc" size={20} class="text-accent" />
              Связанные документы
            </h2>
            <p class="mt-2 max-w-prose text-sm text-muted">{related.title}</p>
            <a
              href={related.href}
              class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-accent-link underline underline-offset-2 transition hover:text-accent2 focus-visible:text-heading active:text-heading"
            >
              {related.label}
              <Icon name="arrowRight" size={16} />
            </a>
          </aside>
        </div>

        <aside class="hidden lg:sticky lg:top-6 lg:block">
          <nav aria-label="Содержание документа" class="card p-5">
            <p class="font-display text-sm font-bold uppercase tracking-wider text-heading">
              Содержание
            </p>
            <ol class="mt-4 space-y-2">
              {
                sections.map((section, index) => (
                  <li>
                    <a
                      href={`#${section.id}`}
                      class="flex min-h-6 items-center gap-3 text-sm text-body transition hover:text-accent-link focus-visible:text-heading active:text-heading"
                    >
                      <span class="shrink-0 tabular-nums text-muted">
                        {String(index + 1).padStart(2, "0")}
                      </span>
                      <span>{section.title}</span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </aside>
      </div>
    </div>
  </article>
</Layout>

<style>
  .legal-toc__summary::-webkit-details-marker {
    display: none;
  }

  .legal-toc__icon {
    transition: transform var(--motion-fast) ease;
  }

  .legal-toc[open] .legal-toc__icon {
    transform: rotate(180deg);
  }
</style>
