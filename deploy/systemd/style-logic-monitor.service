[Unit]
Description=style-logic.ru uptime and lead API monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/style-logic-monitor
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=style-logic-monitor
StateDirectoryMode=0700
