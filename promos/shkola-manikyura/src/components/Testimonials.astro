---
interface Testimonial {
  name: string;
  text: string;
  result: string;
  rating: number;
}

const testimonials: Testimonial[] = [
  {
    name: 'Екатерина',
    text: 'Пришла с нулевыми знаниями, боялась даже рядом с пилочкой стоять. После первого занятия уже сделала маникюр подруге! Очень понятная подача материала и поддержка кураторов 24/7.',
    result: 'Работает в салоне премиум-класса',
    rating: 5,
  },
  {
    name: 'Анна',
    text: 'Искала курсы маникюра, пересмотрела кучу вариантов. Этот курс — лучшее соотношение цены и качества. Особенно понравился модуль по клиентскому сервису. Уже через месяц после курса вышла на 60к.',
    result: 'Зарабатывает 60 000+ в месяц',
    rating: 5,
  },
  {
    name: 'Марина',
    text: 'Прошла проф-тариф с обратной связью от Анны. Разобрали все мои ошибки, исправила технику. Теперь покрытие стоит по 3 недели без сколов. Спасибо огромное!',
    result: 'Открыла свою студию',
    rating: 5,
  },
  {
    name: 'Ольга',
    text: 'Курс превзошёл ожидания! Много практики, доступные объяснения. Отдельное спасибо за блок по педикюру — всегда боялась его делать, а сейчас это моя любимая услуга.',
    result: 'Топ-мастер салона красоты',
    rating: 5,
  },
];
---

<section id="testimonials" class="bg-bg py-16 md:py-24" data-reveal>
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-16 text-center">
      <span class="mb-4 inline-block text-sm font-semibold uppercase tracking-widest text-accent-dark dark:text-accent-light">
        Отзывы
      </span>
      <h2 class="text-balance font-serif text-3xl font-bold text-text sm:text-4xl">
        Что говорят наши ученицы
      </h2>
    </div>

    <div class="grid gap-8 md:grid-cols-2" data-stagger>
      {testimonials.map((t) => (
        <div class="rounded-2xl border border-border bg-surface p-8 transition-all duration-200 hover:shadow-xl" data-reveal>
          <div class="flex items-center gap-1 mb-4">
            {Array.from({ length: t.rating }, () => (
              <svg class="h-5 w-5 text-accent-dark dark:text-accent-light" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-text-secondary leading-relaxed">"{t.text}"</p>
          <div class="mt-6 flex items-center gap-4 border-t border-border pt-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-accent/20 text-sm font-bold text-accent-dark">
              {t.name[0]}
            </div>
            <div>
              <p class="font-semibold text-text">{t.name}</p>
              <p class="text-sm text-text-secondary">{t.result}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
