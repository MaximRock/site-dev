---
import SignupForm from './SignupForm.astro';

interface PricingTier {
  name: string;
  price: string;
  description: string;
  features: string[];
  highlighted: boolean;
}

const tiers: PricingTier[] = [
  {
    name: 'Базовый',
    price: '3 990 ₽',
    description: 'Все материалы курса в записи',
    features: [
      '6 модулей основной программы',
      'Видеоуроки в записи',
      'Конспекты и схемы',
      'Доступ навсегда',
      'Сертификат',
    ],
    highlighted: false,
  },
  {
    name: 'Профессиональный',
    price: '9 990 ₽',
    description: 'Полный курс с обратной связью',
    features: [
      'Всё из тарифа Базовый',
      'Проверка домашних заданий',
      'Обратная связь от наставника',
      'Чат с ученицами',
      'Разбор ошибок',
      'Бонус: модуль по соцсетям',
    ],
    highlighted: true,
  },
  {
    name: 'VIP',
    price: '24 990 ₽',
    description: 'Индивидуальное обучение с Анной',
    features: [
      'Всё из тарифа Профессиональный',
      'Личные консультации с Анной',
      'Индивидуальная программа',
      'Помощь с трудоустройством',
      'Сопровождение 3 месяца',
      'Бонус: фотосессия работ',
    ],
    highlighted: false,
  },
];
---

<section id="pricing" class="bg-bg py-16 md:py-24" data-reveal>
  <div class="mx-auto max-w-7xl px-6">
    <div class="mb-16 text-center">
      <span class="mb-4 inline-block text-sm font-semibold uppercase tracking-widest text-accent-dark dark:text-accent-light">
        Тарифы
      </span>
      <h2 class="text-balance font-serif text-3xl font-bold text-text sm:text-4xl">
        Выберите свой формат обучения
      </h2>
    </div>

    <div class="grid gap-8 lg:grid-cols-3" data-stagger>
      {tiers.map((tier) => (
        <div
          class={`relative flex flex-col rounded-3xl border-2 p-8 transition-all duration-200 hover:-translate-y-1 ${
            tier.highlighted
              ? 'border-accent bg-surface shadow-lg shadow-accent/10 scale-105 lg:scale-110 hover:glow-gold-lg'
              : 'border-border bg-surface hover:glow-gold'
          }`}
          data-reveal
        >
          {tier.highlighted && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-accent px-4 py-1 text-xs font-semibold uppercase tracking-wider text-primary">
              Популярный
            </span>
          )}

          <div class="mb-6">
            <h3 class="text-xl font-bold text-text">{tier.name}</h3>
            <p class="mt-1 text-sm text-text-secondary">{tier.description}</p>
          </div>

          <p class="font-serif text-4xl font-bold text-text">
            {tier.price}
          </p>
          <p class="mt-1 text-sm text-text-muted">единоразово</p>

          <ul class="mt-8 flex-1 space-y-4" role="list">
            {tier.features.map((feature) => (
              <li class="flex items-start gap-3 text-sm text-text-secondary">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent-dark dark:text-accent-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>

          <button
            type="button"
            data-tier={tier.name}
            class={`mt-8 inline-flex cursor-pointer items-center justify-center rounded-full px-6 py-3 text-sm font-semibold transition-all duration-200 ${
              tier.highlighted
                ? 'bg-accent text-primary hover:bg-accent-light hover:glow-gold'
                : 'border border-text-muted/30 bg-surface text-text hover:bg-primary/5 hover:glow-gold'
            }`}
          >
            Выбрать тариф
          </button>
        </div>
      ))}
    </div>
  </div>
</section>

<SignupForm tierName="" />

<script>
document.querySelectorAll('[data-tier]').forEach(function (btn) {
  btn.addEventListener('click', function () {
    var overlay = document.getElementById('signup-overlay');
    if (overlay) {
      var tierEl = overlay.querySelector('.tier-name');
      if (tierEl) tierEl.textContent = btn.getAttribute('data-tier') || '';
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
    }
  });
});
</script>
