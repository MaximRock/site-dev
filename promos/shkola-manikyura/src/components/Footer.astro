---
import { withBase } from '../lib/withBase';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-primary py-16" data-reveal>
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid gap-12 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <a href={withBase('/')} class="font-serif text-2xl font-bold text-accent tracking-wide">
          Nail School
        </a>
        <p class="mt-4 max-w-sm text-sm text-text-muted leading-relaxed">
          Премиальная школа маникюра. Обучаем профессии мастер маникюра с нуля до PRO.
          Пошаговая программа, поддержка наставника и помощь с трудоустройством.
        </p>
      </div>

      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-widest text-text-on-dark">Навигация</h4>
        <ul class="space-y-3">
          <li><a href="#about" class="text-sm text-text-muted transition-colors duration-200 hover:text-accent-light">О курсе</a></li>
          <li><a href="#program" class="text-sm text-text-muted transition-colors duration-200 hover:text-accent-light">Программа</a></li>
          <li><a href="#works" class="text-sm text-text-muted transition-colors duration-200 hover:text-accent-light">Работы учениц</a></li>
          <li><a href="#testimonials" class="text-sm text-text-muted transition-colors duration-200 hover:text-accent-light">Отзывы</a></li>
          <li><a href="#pricing" class="text-sm text-text-muted transition-colors duration-200 hover:text-accent-light">Тарифы</a></li>
        </ul>
      </div>

      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-widest text-text-on-dark">Контакты</h4>
        <ul class="space-y-3">
          <li><a href="#" class="text-sm text-text-muted transition-colors duration-200 hover:text-accent-light">Telegram</a></li>
          <li><a href="#" class="text-sm text-text-muted transition-colors duration-200 hover:text-accent-light">WhatsApp</a></li>
          <li><a href="#" class="text-sm text-text-muted transition-colors duration-200 hover:text-accent-light">Instagram</a></li>
          <li><a href="#" class="text-sm text-text-muted transition-colors duration-200 hover:text-accent-light">VK</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 sm:flex-row">
      <p class="text-xs text-text-muted">&copy; {currentYear} Nail School. Все права защищены.</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        <a href={withBase('/politika/')} class="text-xs text-text-muted transition-colors duration-200 hover:text-accent-light">Политика конфиденциальности</a>
        <a href={withBase('/cookie/')} class="text-xs text-text-muted transition-colors duration-200 hover:text-accent-light">Политика cookie-файлы</a>
        <a href={withBase('/politica-2/')} class="text-xs text-text-muted transition-colors duration-200 hover:text-accent-light">Политика обработки персональных данных</a>
      </div>
    </div>
  </div>
</footer>
