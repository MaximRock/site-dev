---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<section class="page-intro">
  <div class="container--narrow">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="page-intro__title" id="page-title">
      {title}
    </h1>
    <p class="lead page-intro__lead">{lead}</p>
  </div>
</section>
