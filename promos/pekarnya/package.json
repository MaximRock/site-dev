{
  "name": "teply-ugolok-bakery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run tokens && astro dev",
    "build": "npm run tokens && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "tokens": "node scripts/build-tokens.mjs",
    "assets:brand": "node scripts/build-brand.mjs",
    "assets:icons": "node scripts/build-icons.mjs",
    "assets:og": "node scripts/build-og.mjs",
    "capture:case": "node scripts/capture-case.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "astro": "7.4.11",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "playwright": "^1.59.1",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  }
}
