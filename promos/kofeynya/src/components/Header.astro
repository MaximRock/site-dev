---
import type { NavLink } from "../data/cafe";

interface Props {
  siteName: string;
  nav: NavLink[];
}

const { siteName, nav } = Astro.props;
const [menuLink, ...restNav] = nav;
const desktopNav = restNav.filter((l) => l.href !== "#hours");
const bottomNav = nav.filter((l) => l.href === "#visit" || l.href === "#hours");
---

<div class="md:pt-[15px]">
  <header class="sticky top-0 z-40 bg-paper">
    <div class="mx-auto max-w-[1200px] px-6 md:px-0">
    <div class="md:border md:border-coffee md:px-6">
      <div class="flex h-14 items-center justify-between gap-6">
        <a href="#top" class="inline-flex min-h-[44px] items-center font-display text-xl lowercase leading-none">{siteName}</a>
        <nav aria-label="разделы" class="hidden items-baseline gap-5 md:flex">
          {
            desktopNav.map((l) => (
              <a href={l.href} class="inline-flex min-h-[44px] items-center text-[15px] underline-offset-4 hover:text-lingonberry hover:underline">
                {l.label}
              </a>
            ))
          }
        </nav>
        <a
          href={menuLink.href}
          class="inline-flex min-h-[44px] items-center text-[15px] underline-offset-4 hover:text-lingonberry hover:underline md:hidden"
        >
          {menuLink.label}
        </a>
      </div>
    </div>
</div>
  </header>
</div>
<nav
  aria-label="как найти"
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 border-t border-ink bg-paper pb-[env(safe-area-inset-bottom)] md:hidden"
>
  {
    bottomNav.map((l) => (
      <a
        href={l.href}
        class="flex min-h-[56px] items-center justify-center text-[15px] underline-offset-4 hover:text-lingonberry"
      >
        {l.label}
      </a>
    ))
  }
</nav>
