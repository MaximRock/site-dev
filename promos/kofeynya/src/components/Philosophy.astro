---
interface Props {
  theses: string[];
  handwritten: string[];
}

const { theses, handwritten } = Astro.props;
---

<section aria-label="правила" class="mx-auto max-w-[1200px] px-6 pb-16 md:pb-24">
  <div class="grid grid-cols-1 md:grid-cols-12 md:gap-6">
    <ol class="md:col-span-5 md:col-start-2">
      {
        theses.map((t, i) => (
          <li class="reveal border-t border-ink/15 py-4 font-display text-xl lowercase">
            <span class="mr-3 font-mono text-[13px] text-pencil-ink">0{i + 1}</span>
            {t}
          </li>
        ))
      }
    </ol>
    <div class="md:col-span-4 md:col-start-8">
      {
        handwritten.map((h) => (
          <p class="reveal mt-4 text-[15px] italic text-ink/80">*{h}</p>
        ))
      }
    </div>
  </div>
</section>
