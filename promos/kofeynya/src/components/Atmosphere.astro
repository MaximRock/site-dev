---
import { withBase } from "../lib/withBase";

interface Props {
  facts: string[];
  interiorCaption: string;
  guestsCaption: string;
}

const { facts, interiorCaption, guestsCaption } = Astro.props;
---

<section id="inside" aria-label="внутри" class="mx-auto max-w-[1200px] scroll-mt-32 px-6 py-12 md:py-16">
  <div class="grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-6">
    <figure class="reveal-img -mx-6 md:mx-0 md:col-span-7">
      <img
        src={withBase("/images/interior.webp")}
        alt="Зал кофейни с деревянными столами и гостями у окон"
        width="840"
        height="525"
        class="aspect-[16/10] w-full object-cover object-center"
        loading="lazy"
      />
      <figcaption class="mt-2 px-6 font-mono text-xs text-pencil-ink md:px-0">{interiorCaption}</figcaption>
    </figure>
    <div class="md:col-span-4 md:col-start-9">
      <p class="reveal font-mono text-[13px] text-pencil-ink">03 / внутри</p>
      <ul>
        {
          facts.map((f) => (
            <li class="reveal border-b border-ink/15 py-3 text-base">{f}</li>
          ))
        }
      </ul>
    </div>
  </div>
  <figure class="reveal-img -mx-6 mt-10 md:mx-[8.333%]">
    <picture class="block">
      <source
        media="(max-width: 767px)"
        srcset={withBase("/images/guests-mobile.webp")}
        width="864"
        height="648"
      />
      <img
        src={withBase("/images/guests.webp")}
        alt="Гости за столами с газетами и ноутбуком"
        width="1200"
        height="300"
        class="aspect-[4/3] w-full object-cover object-center md:aspect-auto md:h-[180px]"
        loading="lazy"
      />
    </picture>
    <figcaption class="mt-2 px-6 font-mono text-xs text-pencil-ink md:px-0">{guestsCaption}</figcaption>
  </figure>
</section>
