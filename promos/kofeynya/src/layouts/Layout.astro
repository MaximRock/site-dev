---
import "../styles/global.css";
import { siteName, siteTagline } from "../data/cafe";
import { withBase } from "../lib/withBase";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteName} — ${siteTagline}`,
  description = "форточка — кофейня на каждый день. фильтр по времени. улитка одна.",
} = Astro.props;

const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, site).href;
const ogImageURL = new URL(withBase("/images/street.webp"), site).href;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#ECEBE6" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700&family=Golos+Text:wght@400;500&family=PT+Mono&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-paper text-ink font-text">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      перейти к содержимому
    </a>
    <slot />
    <script>
      document.documentElement.classList.add("js");
      const els = document.querySelectorAll(".reveal, .reveal-img");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }

      // Точечный параллакс: только street, ±16px в пределах кадра.
      // Выключен на тач и при reduced-motion.
      const canParallax =
        window.matchMedia("(hover: hover)").matches &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const frame = document.querySelector("[data-parallax]");
      const pimg = frame?.querySelector("img");
      if (canParallax && frame && pimg) {
        let ticking = false;
        const update = () => {
          ticking = false;
          const r = frame.getBoundingClientRect();
          const vh = window.innerHeight;
          const p = Math.max(
            -1,
            Math.min(1, (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2)),
          );
          pimg.style.transform = `translateY(${(p * -16).toFixed(1)}px)`;
        };
        const request = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };
        update();
        window.addEventListener("scroll", request, { passive: true });
        window.addEventListener("resize", request);
      }
    </script>
  </body>
</html>
